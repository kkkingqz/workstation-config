#!/bin/sh
# The resume did not happen (no matching kernel, bad image): bring the T2
# stack back that local-top/ws-t2-resume took off (helpws suspend, Hibernate).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

[ -e /run/ws-t2-detached ] || exit 0
. /scripts/functions
rm -f /etc/modprobe.d/ws-t2-resume.conf /run/ws-t2-detached
log_begin_msg "Resume did not happen: T2 stack on again (ws-t2-detach)"
/usr/sbin/ws-t2-detach up
log_end_msg
