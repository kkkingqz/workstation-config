#!/bin/sh
# helpws plan-dgpu: with t2gmux driving the gmux the switched-off AMD stays on
# the PCI bus, and amdgpu cannot suspend a card without power (MODE1 reset
# fails, S3 aborts; helpws suspend). KaiT2en powers the card on before sleep,
# but on this MacBookPro16,1 switcheroo ON through t2gmux powers the whole
# machine off while amdgpu resumes the SMU (2026-10-01, t2gmux 398dd080).
# So a t2gmux test boot must not sleep at all: ws-dgpu-off holds a sleep
# inhibitor there. This hook only logs if a sleep gets through anyway.

ls /sys/bus/pnp/drivers/t2gmux 2>/dev/null | grep -q ':' || exit 0

case "$1" in
    pre)
        logger -t ws-dgpu-t2gmux "sleep with t2gmux and the AMD on the bus: not safe (helpws plan-dgpu)"
        ;;
esac

exit 0
