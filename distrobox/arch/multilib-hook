#!/bin/sh
# distrobox pre-init hook (root, every start, before the package setup):
# enable [multilib] so additional_packages can take lib32-* and
# umu-launcher.
set -eu
grep -q '^\[multilib\]' /etc/pacman.conf && exit 0
printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf
