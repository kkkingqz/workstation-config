#!/bin/sh
# distrobox init hook (root, every start): install the given packages once.
# For packages that must come after another hook (wine needs the
# wsbox-host-ntsync provider), so they cannot be additional_packages.
set -eu
pacman -Q "$@" >/dev/null 2>&1 && exit 0
pacman -S --needed --noconfirm "$@"
