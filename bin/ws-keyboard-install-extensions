#!/usr/bin/env bash
set -euo pipefail

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"

die() {
    echo "ws-keyboard-install-extensions: $*" >&2
    exit 1
}

for cmd in python3 glib-compile-schemas; do
    command -v "$cmd" >/dev/null 2>&1 || die "$cmd not found"
done

install_extension() {
    local uuid="$1"
    local src="$repo/gnome/extensions/$uuid"
    local dst="$HOME/.local/share/gnome-shell/extensions/$uuid"
    local schema_dir="$src/schemas"

    [[ -f "$src/metadata.json" ]] || die "missing $src/metadata.json"
    [[ -f "$src/extension.js" ]] || die "missing $src/extension.js"

    local has_schema=false
    if [[ -d "$schema_dir" ]] && compgen -G "$schema_dir/*.gschema.xml" >/dev/null; then
        has_schema=true
    fi

    python3 - "$src/metadata.json" "$uuid" <<'PY'
import json
import sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text())
assert data.get("uuid") == sys.argv[2], (data.get("uuid"), sys.argv[2])
assert "50" in data.get("shell-version", []), data.get("shell-version")
PY

    mkdir -p "$dst"

    install -m0644 "$src/metadata.json" "$dst/metadata.json"
    install -m0644 "$src/extension.js" "$dst/extension.js"

    if [[ "$has_schema" == true ]]; then
        mkdir -p "$dst/schemas"

        find "$dst/schemas" -maxdepth 1 -type f \
            \( -name '*.gschema.xml' -o -name 'gschemas.compiled' \) \
            -delete

        local schema
        for schema in "$schema_dir"/*.gschema.xml; do
            install -m0644 "$schema" "$dst/schemas/${schema##*/}"
        done

        glib-compile-schemas "$dst/schemas"
        [[ -f "$dst/schemas/gschemas.compiled" ]] \
            || die "schema compilation did not create $dst/schemas/gschemas.compiled"
    else
        rm -rf -- "$dst/schemas"
    fi

    cmp -s "$src/metadata.json" "$dst/metadata.json" \
        || die "$uuid metadata runtime mismatch"
    cmp -s "$src/extension.js" "$dst/extension.js" \
        || die "$uuid extension runtime mismatch"

    echo "installed: $uuid"
}

# The local extensions of modules/home/gnome-extensions.nix; ws switch builds
# the list and enables them (enabled-extensions).
list="$HOME/.config/workstation/gnome/extensions"
[[ -r "$list" ]] || die "extension list missing: $list (run ws switch)"
mapfile -t local_extensions < <(awk '!/^#/ && $2 == "local" { print $1 }' "$list")
((${#local_extensions[@]})) || die "no local extensions in $list"

for uuid in "${local_extensions[@]}"; do
    install_extension "$uuid"
done

echo
echo "GNOME workstation extension sources installed (enabled by ws switch)."
echo "If extension.js changed, log out and log back in on Wayland before relying on it."
