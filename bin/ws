#!/usr/bin/env bash
set -euo pipefail

# Entry point of the Nix layer (docs/plans/nix-migration.md). Runs as the
# desktop user and calls sudo itself where needed: `sudo ws` would not find
# Nix, secure_path does not contain the Nix profile.

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"

usage() {
    cat <<'USAGE'
Usage:
  ws switch [HOME-MANAGER-ARG...]
  ws diff
  ws apply [STEP...]
  ws check [-v]
  ws baseline capture|diff|list ...
  ws host

switch    home-manager switch for this user and host (pinned by flake.lock)
diff      build the home generation without activating it and show the
          package difference against the current one (nvd)
apply     run the layer owners in order, as by hand (no sudo steps):
            extensions  ws-keyboard-install-extensions
            tiling      ws-tiling-apply
            keyboard    ws-keyboard-apply
            gnome       ws-gnome apply
            flatpak     wsflatpak apply
            distrobox   wsbox apply
          a step whose preflight fails (exit 69: e.g. new extensions need a
          logout/login) is reported at the end; on a new machine:
          ws apply, log out and in, ws apply
check     run the owners' checks (ws-workstation-verify, wsflatpak check,
          wsbox check, ws-gnome check, ws-suspend status) and summarize;
          shows WARN/FAIL lines only, -v shows the full output
baseline  functional baseline, see ws-baseline --help
host      print the flake host name used for this machine
USAGE
}

die() {
    echo "ws: $*" >&2
    exit 1
}

[[ $EUID -ne 0 ]] || die "run as the desktop user, not root"

nix_bin() {
    command -v nix 2>/dev/null \
        || die "nix not found (apt: nix-bin nix-setup-systemd; docs/plans/nix-migration.md, phase 0)"
}

# Flake host for this machine: WS_HOST, else by hostname.
host() {
    if [[ -n "${WS_HOST:-}" ]]; then
        echo "$WS_HOST"
        return
    fi
    case "$(hostname)" in
        MacBookPro-k) echo mbp16 ;;
        *) die "unknown host $(hostname); set WS_HOST or add it to bin/ws" ;;
    esac
}

target() {
    echo "$repo#$(id -un)@$(host)"
}

# The flake sees only files known to git; a new .nix file that is not added
# would silently be missing from the build.
check_untracked() {
    local untracked
    untracked="$(git -C "$repo" ls-files --others --exclude-standard -- \
        flake.nix flake.lock hosts modules pkgs)"
    [[ -z "$untracked" ]] || die "untracked flake files (git add them first):
$untracked"
}

current_generation() {
    local p
    for p in "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager" \
        "/nix/var/nix/profiles/per-user/$(id -un)/home-manager"; do
        if [[ -e "$p" ]]; then
            readlink -f "$p"
            return
        fi
    done
}

cmd_switch() {
    local nix
    nix="$(nix_bin)"
    check_untracked
    "$nix" run "$repo#home-manager" -- switch --flake "$(target)" "$@"
}

cmd_diff() {
    local nix new old
    nix="$(nix_bin)"
    check_untracked
    new="$("$nix" build --no-link --print-out-paths \
        "$repo#homeConfigurations.\"$(id -un)@$(host)\".activationPackage")"
    old="$(current_generation)"
    if [[ -z "$old" ]]; then
        echo "no home-manager generation yet; new: $new"
        return
    fi
    "$nix" run "$repo#nvd" -- diff "$old" "$new"
}

# Layer owners in apply order: name, command.
apply_steps=(
    "extensions ws-keyboard-install-extensions"
    "tiling ws-tiling-apply"
    "keyboard ws-keyboard-apply"
    "gnome ws-gnome apply"
    "flatpak wsflatpak apply"
    "distrobox wsbox apply"
)

cmd_apply() {
    local wanted=("$@") step name cmd rc known
    local -a results=()
    local failed=false

    for name in "${wanted[@]}"; do
        known=false
        for step in "${apply_steps[@]}"; do
            [[ "${step%% *}" == "$name" ]] && known=true
        done
        [[ "$known" == true ]] || die "unknown apply step: $name"
    done

    for step in "${apply_steps[@]}"; do
        name="${step%% *}"
        cmd="${step#* }"
        if ((${#wanted[@]})) && [[ " ${wanted[*]} " != *" $name "* ]]; then
            continue
        fi
        printf '\n=== %s: %s\n' "$name" "$cmd"
        rc=0
        # shellcheck disable=SC2086 # cmd is a fixed command line
        "$repo/bin/"$cmd || rc=$?
        case "$rc" in
            0) results+=("OK        $name") ;;
            69) results+=("PREFLIGHT $name (log out and in, then: ws apply $name)"); failed=true ;;
            *) results+=("FAIL      $name (exit $rc)"); failed=true ;;
        esac
    done

    printf '\n=== ws apply\n'
    printf '  %s\n' "${results[@]}"
    [[ "$failed" == false ]]
}

# Owner checks: name, command. Problem lines are WARN/FAIL (verify, wsflatpak,
# wsbox), DRIFT (ws-gnome), DIFFERS/MISSING and an unheld kernel (ws-suspend).
check_steps=(
    "verify ws-workstation-verify"
    "flatpak wsflatpak check"
    "distrobox wsbox check"
    "gnome ws-gnome check"
    "suspend ws-suspend status"
)

cmd_check() {
    local verbose=false step name cmd rc out warn fail
    local -a results=()
    local total_warn=0 total_fail=0

    case "${1:-}" in
        -v|--verbose) verbose=true ;;
        "") ;;
        *) die "unknown check option: $1" ;;
    esac

    out="$(mktemp)"
    trap 'rm -f "$out"' RETURN

    for step in "${check_steps[@]}"; do
        name="${step%% *}"
        cmd="${step#* }"
        rc=0
        # shellcheck disable=SC2086 # cmd is a fixed command line
        "$repo/bin/"$cmd > "$out" 2>&1 || rc=$?
        warn="$(grep -cE '^[[:space:]]*WARN[[:space:]]|not held' "$out" || true)"
        fail="$(grep -cE '^[[:space:]]*(FAIL|DRIFT|DIFFERS|MISSING)[[:space:]]' "$out" || true)"
        # A non-zero exit without problem lines still counts as one failure.
        if ((rc != 0 && fail == 0)); then
            fail=1
        fi

        printf '\n=== %s: %s (exit %s)\n' "$name" "$cmd" "$rc"
        if [[ "$verbose" == true ]]; then
            cat "$out"
        else
            grep -E '^[[:space:]]*(WARN|FAIL|DRIFT|DIFFERS|MISSING)[[:space:]]|not held' "$out" || true
        fi

        total_warn=$((total_warn + warn))
        total_fail=$((total_fail + fail))
        if ((fail)); then
            results+=("FAIL  $name ($fail)")
        elif ((warn)); then
            results+=("WARN  $name ($warn)")
        else
            results+=("OK    $name")
        fi
    done

    printf '\n=== ws check\n'
    printf '  %s\n' "${results[@]}"
    printf '  FAIL=%d WARN=%d\n' "$total_fail" "$total_warn"
    ((total_fail == 0))
}

case "${1:-}" in
    apply) shift; cmd_apply "$@" ;;
    check) shift; cmd_check "$@" ;;
    switch) shift; cmd_switch "$@" ;;
    diff) shift; cmd_diff "$@" ;;
    baseline) shift; exec "$repo/bin/ws-baseline" "$@" ;;
    host) host ;;
    -h|--help|help) usage ;;
    "") usage; exit 1 ;;
    *) usage >&2; exit 1 ;;
esac
