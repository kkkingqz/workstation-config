#!/usr/bin/env python3

import ast
import os
from pathlib import Path
import subprocess

SCHEMA = "org.gnome.shell.extensions.tiling-assistant"

# Private chords emitted by xremap, appended to the Tiling Assistant defaults
# (never replacing them). Declared in keyboard/keyboard.nix, built by
# ws switch as KEY<TAB>BINDING lines.
BINDINGS_FILE = Path(
    os.environ.get(
        "WS_TILING_BINDINGS",
        Path.home() / ".local/share/workstation/keyboard/tiling-bindings.tsv",
    )
)


def load_bindings():
    if not BINDINGS_FILE.is_file():
        raise SystemExit(
            f"ws-tiling-apply: missing {BINDINGS_FILE} (run ws switch)"
        )

    bindings = {}
    for line in BINDINGS_FILE.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        key, binding = line.split("\t")
        bindings.setdefault(key, []).append(binding)

    if not bindings:
        raise SystemExit(f"ws-tiling-apply: no bindings in {BINDINGS_FILE}")
    return bindings


def run(*args):
    return subprocess.check_output(args, text=True).strip()


def parse_array(raw):
    raw = raw.strip()
    if raw.startswith("@as "):
        raw = raw[4:].strip()

    value = ast.literal_eval(raw)
    if not isinstance(value, list):
        raise ValueError(f"expected string array, got: {raw}")

    return value


def main():
    BINDINGS = load_bindings()
    keys = set(run("gsettings", "list-keys", SCHEMA).splitlines())
    missing = [key for key in BINDINGS if key not in keys]
    if missing:
        raise SystemExit(
            "ws-tiling-apply: missing Tiling Assistant keys: "
            + ", ".join(missing)
        )

    for key, private_bindings in BINDINGS.items():
        raw = run("gsettings", "get", SCHEMA, key)
        current = parse_array(raw)
        wanted = current + [b for b in private_bindings if b not in current]

        if wanted != current:
            subprocess.run(
                ["gsettings", "set", SCHEMA, key, repr(wanted)],
                check=True,
            )

    print("Tiling Assistant private bindings:")
    for key in BINDINGS:
        print(f"  {key}: {run('gsettings', 'get', SCHEMA, key)}")


if __name__ == "__main__":
    main()
