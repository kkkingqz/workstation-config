#!/usr/bin/env sh
set -eu

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"
mandir="$repo/man/man1"

mkdir -p "$mandir"

find "$repo/docs" -type f -name '*.md' | sort | while IFS= read -r doc; do
    page="$(sed -n 's/^title:[[:space:]]*//p' "$doc" | head -n 1)"
    [ -n "$page" ] || {
        echo "Skipping $doc: no title metadata" >&2
        continue
    }
    lowdown -s -t man "$doc" > "$mandir/$page.1"
    echo "Generated: $mandir/$page.1"
done
