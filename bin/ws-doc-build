#!/usr/bin/env sh
set -eu

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"
mandir="$repo/man/man1"

mkdir -p "$mandir"

lowdown -s -t man "$repo/docs/terminal.md" > "$mandir/ws-terminal.1"
lowdown -s -t man "$repo/docs/workstation.md" > "$mandir/ws-workstation.1"

echo "Generated:"
echo "  $mandir/ws-terminal.1"
echo "  $mandir/ws-workstation.1"
