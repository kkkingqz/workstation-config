#!/usr/bin/env bash
set -euo pipefail

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"
manifest="$repo/config/distrobox/containers.ini"
exports_manifest="$repo/config/distrobox/exports.ini"

usage() {
    cat <<'USAGE'
Usage:
  wsbox list
  wsbox status [NAME]
  wsbox check
  wsbox dry-run [NAME]
  wsbox apply [NAME]
  wsbox create NAME
  wsbox enter NAME
  wsbox run NAME COMMAND [ARG...]
  wsbox stop NAME
  wsbox remove --force NAME
  wsbox recreate NAME
  wsbox apps [NAME]
  wsbox export NAME APP
  wsbox unexport NAME APP
USAGE
}

die() {
    printf 'wsbox: %s\n' "$*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

ensure_base() {
    need podman
    need distrobox
    need distrobox-assemble
    [[ -r "$manifest" ]] || die "manifest not found: $manifest"
    [[ -r "$exports_manifest" ]] || die "exports manifest not found: $exports_manifest"
}

managed_boxes() {
    sed -nE 's/^\[([^]]+)\]$/\1/p' "$manifest"
}

ini_value() {
    local file="$1" section="$2" key="$3" value

    value="$({
        awk -F= -v section="[$section]" -v key="$key" '
            $0 == section {
                inside=1
                next
            }

            inside && /^\[/ {
                exit
            }

            inside {
                k=$1
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)

                if (k == key) {
                    sub(/^[^=]*=/, "", $0)
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
                    print $0
                    exit
                }
            }
        ' "$file"
    } || true)"

    value="${value#\"}"
    value="${value%\"}"
    value="${value//\$\{HOME\}/$HOME}"

    printf '%s\n' "$value"
}

manifest_value() {
    ini_value "$manifest" "$1" "$2"
}

export_sections() {
    sed -nE 's/^\[([^]]+)\]$/\1/p' "$exports_manifest"
}

export_aliases() {
    local name="$1"

    awk -F= -v section="[$name]" '
        $0 == section {
            inside=1
            next
        }

        inside && /^\[/ {
            exit
        }

        inside {
            line=$0
            sub(/[[:space:]]*[#;].*$/, "", line)
            if (line !~ /=/) next

            split(line, parts, "=")
            key=parts[1]
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            if (key != "") print key
        }
    ' "$exports_manifest"
}

export_source() {
    ini_value "$exports_manifest" "$1" "$2"
}

is_managed() {
    managed_boxes | grep -Fxq -- "$1"
}

require_managed() {
    [[ -n "${1:-}" ]] || die "container name required"
    is_managed "$1" || die "not a managed container: $1"
}

is_managed_export() {
    local name="$1" alias="$2"
    export_aliases "$name" | grep -Fxq -- "$alias"
}

require_managed_export() {
    local name="$1" alias="$2"

    [[ -n "$alias" ]] || die "managed app alias required"
    is_managed_export "$name" "$alias" \
        || die "not a managed export: $name/$alias"
}

container_exists() {
    podman container exists "$1" >/dev/null 2>&1
}

container_state() {
    podman inspect \
        --format '{{.State.Status}}' \
        "$1" \
        2>/dev/null \
        || printf 'unknown\n'
}

container_image() {
    podman inspect \
        --format '{{.ImageName}}' \
        "$1" \
        2>/dev/null \
        || podman inspect \
            --format '{{.Config.Image}}' \
            "$1" \
            2>/dev/null \
        || printf 'unknown\n'
}

container_exec() {
    local name="$1"
    shift

    distrobox enter \
        --name "$name" \
        -- "$@"
}

export_source_exists() {
    local name="$1" source="$2"

    container_exec "$name" test -f "$source" \
        >/dev/null 2>&1
}

export_host_path() {
    local name="$1" source="$2"
    printf '%s/.local/share/applications/%s-%s\n' \
        "$HOME" "$name" "$(basename "$source")"
}

export_launcher_targets() {
    local name="$1" launcher="$2" exec_line

    [[ -f "$launcher" ]] || return 1
    exec_line="$(grep -m1 '^Exec=' "$launcher" 2>/dev/null || true)"

    [[ "$exec_line" == *distrobox-enter* ]] || return 1
    [[ "$exec_line" == *"-n $name"* ]] || return 1
}

export_state() {
    local name="$1" source="$2" launcher

    if ! export_source_exists "$name" "$source"; then
        printf 'missing-source\n'
        return 0
    fi

    launcher="$(export_host_path "$name" "$source")"

    if [[ ! -f "$launcher" ]]; then
        printf 'not-exported\n'
    elif export_launcher_targets "$name" "$launcher"; then
        printf 'exported\n'
    else
        printf 'drift\n'
    fi
}

export_one() {
    local name="$1" alias="$2" source launcher

    require_managed "$name"
    require_managed_export "$name" "$alias"
    container_exists "$name" || die "container does not exist: $name"

    source="$(export_source "$name" "$alias")"
    [[ -n "$source" ]] || die "empty export source: $name/$alias"

    export_source_exists "$name" "$source" \
        || die "managed export source missing: $name/$alias: $source"

    launcher="$(export_host_path "$name" "$source")"

    if export_launcher_targets "$name" "$launcher"; then
        printf 'Already exported: %s/%s\n' "$name" "$alias"
        return 0
    fi

    rm -f -- "$launcher"

    container_exec "$name" distrobox-export \
        --app "$source" \
        --export-label none

    export_launcher_targets "$name" "$launcher" \
        || die "export did not create a valid launcher: $launcher"

    printf 'Exported: %s/%s -> %s\n' "$name" "$alias" "$launcher"
}

unexport_one() {
    local name="$1" alias="$2" source launcher

    require_managed "$name"
    require_managed_export "$name" "$alias"
    container_exists "$name" || die "container does not exist: $name"

    source="$(export_source "$name" "$alias")"
    [[ -n "$source" ]] || die "empty export source: $name/$alias"
    launcher="$(export_host_path "$name" "$source")"

    if export_source_exists "$name" "$source"; then
        container_exec "$name" distrobox-export \
            --app "$source" \
            --delete \
            >/dev/null 2>&1 \
            || true
    fi

    rm -f -- "$launcher"
    printf 'Unexported: %s/%s\n' "$name" "$alias"
}

apply_exports_for() {
    local name="$1" alias source state

    container_exists "$name" || return 0

    while IFS= read -r alias; do
        [[ -n "$alias" ]] || continue
        source="$(export_source "$name" "$alias")"

        if [[ -z "$source" ]] || ! export_source_exists "$name" "$source"; then
            printf '  WARN  managed export source missing: %s/%s: %s\n' \
                "$name" "$alias" "${source:-<empty>}"
            continue
        fi

        state="$(export_state "$name" "$source")"

        if [[ "$state" == exported ]]; then
            printf '  PASS  managed export already present: %s/%s\n' \
                "$name" "$alias"
            continue
        fi

        export_one "$name" "$alias"
    done < <(export_aliases "$name")
}

status_one() {
    local name="$1"
    local expected_image
    local expected_home
    local state
    local actual_image
    local home_state

    expected_image="$(manifest_value "$name" image)"
    expected_home="$(manifest_value "$name" home)"

    if container_exists "$name"; then
        state="$(container_state "$name")"
        actual_image="$(container_image "$name")"
    else
        state="missing"
        actual_image="-"
    fi

    if [[ -d "$expected_home" ]]; then
        home_state="present"
    else
        home_state="absent"
    fi

    printf '%-10s %-12s %-38s %-8s %s\n' \
        "$name" \
        "$state" \
        "$actual_image" \
        "$home_state" \
        "$expected_home"
}

cmd_list() {
    distrobox list --no-color
}

cmd_status() {
    local name="${1:-}"

    printf '%-10s %-12s %-38s %-8s %s\n' \
        NAME STATE IMAGE HOME PATH

    printf '%s\n' \
        '-----------------------------------------------------------------------------------------------'

    if [[ -n "$name" ]]; then
        require_managed "$name"
        status_one "$name"
    else
        while IFS= read -r name; do
            [[ -n "$name" ]] && status_one "$name"
        done < <(managed_boxes)
    fi

    local extras=""

    extras="$(
        podman ps -a \
            --filter label=manager=distrobox \
            --format '{{.Names}}' \
            2>/dev/null \
        | while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            is_managed "$name" || printf '%s\n' "$name"
        done
    )"

    if [[ -n "$extras" ]]; then
        echo
        echo "Unmanaged Distrobox containers:"
        printf '  %s\n' $extras
    fi
}

check_exports_for() {
    local name="$1" alias source launcher

    container_exists "$name" || return 0

    while IFS= read -r alias; do
        [[ -n "$alias" ]] || continue
        source="$(export_source "$name" "$alias")"

        if [[ -z "$source" ]] || ! export_source_exists "$name" "$source"; then
            warn "managed export source missing: $name/$alias: ${source:-<empty>}"
            continue
        fi

        pass "managed export source exists: $name/$alias"
        launcher="$(export_host_path "$name" "$source")"

        if [[ ! -f "$launcher" ]]; then
            fail "managed export missing: $name/$alias: $launcher"
        elif export_launcher_targets "$name" "$launcher"; then
            pass "managed export launcher valid: $name/$alias"
        else
            fail "managed export launcher drift: $name/$alias: $launcher"
        fi
    done < <(export_aliases "$name")
}

cmd_check() {
    local failures=0
    local warnings=0
    local name
    local expected_image
    local actual_image
    local expected_home

    pass() {
        printf '  PASS  %s\n' "$*"
    }

    warn() {
        ((warnings+=1))
        printf '  WARN  %s\n' "$*"
    }

    fail() {
        ((failures+=1))
        printf '  FAIL  %s\n' "$*"
    }

    for p in \
        podman \
        distrobox \
        uidmap \
        fuse-overlayfs \
        slirp4netns \
        passt
    do
        if dpkg-query -W -f='${Status}' "$p" 2>/dev/null \
            | grep -qx 'install ok installed'
        then
            pass "package installed: $p"
        else
            fail "package missing: $p"
        fi
    done

    if [[ "$(
        podman info \
            --format '{{.Host.Security.Rootless}}' \
            2>/dev/null \
            || true
    )" == "true" ]]
    then
        pass "Podman rootless"
    else
        fail "Podman is not rootless"
    fi

    if [[ -r "$manifest" ]]; then
        pass "manifest present"
    else
        fail "manifest missing"
    fi

    if [[ -r "$exports_manifest" ]]; then
        pass "exports manifest present"

        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            if is_managed "$name"; then
                pass "exports section targets managed container: $name"
            else
                fail "exports section targets unmanaged container: $name"
            fi
        done < <(export_sections)
    else
        fail "exports manifest missing"
    fi

    while IFS= read -r name; do
        [[ -n "$name" ]] || continue

        expected_image="$(manifest_value "$name" image)"
        expected_home="$(manifest_value "$name" home)"

        if ! container_exists "$name"; then
            fail "managed container missing: $name"
            continue
        fi

        pass "managed container exists: $name"

        actual_image="$(container_image "$name")"

        if [[ "$actual_image" == "$expected_image" ]]; then
            pass "$name image matches manifest"
        else
            fail "$name image drift: got $actual_image, expected $expected_image"
        fi

        if [[ -d "$expected_home" ]]; then
            pass "$name custom HOME exists"
        else
            fail "$name custom HOME missing: $expected_home"
        fi

        check_exports_for "$name"
    done < <(managed_boxes)

    while IFS= read -r name; do
        [[ -n "$name" ]] || continue

        if ! is_managed "$name"; then
            warn "unmanaged Distrobox container: $name"
        fi

    done < <(
        podman ps -a \
            --filter label=manager=distrobox \
            --format '{{.Names}}' \
            2>/dev/null
    )

    echo
    printf 'FAIL=%d WARN=%d\n' \
        "$failures" \
        "$warnings"

    (( failures == 0 ))
}

cmd_dry_run() {
    local name="${1:-}"
    local args=(
        create
        --file "$manifest"
        --dry-run
    )

    if [[ -n "$name" ]]; then
        require_managed "$name"
        args+=(--name "$name")
    fi

    distrobox assemble "${args[@]}"
}

cmd_apply() {
    local name="${1:-}"
    local box
    local args=(
        create
        --file "$manifest"
    )

    if [[ -n "$name" ]]; then
        require_managed "$name"
        args+=(--name "$name")
    fi

    distrobox assemble "${args[@]}"

    if [[ -n "$name" ]]; then
        apply_exports_for "$name"
    else
        while IFS= read -r box; do
            [[ -n "$box" ]] && apply_exports_for "$box"
        done < <(managed_boxes)
    fi
}

cmd_create() {
    local name="${1:-}"

    require_managed "$name"

    container_exists "$name" \
        && die "container already exists: $name"

    distrobox assemble create \
        --file "$manifest" \
        --name "$name"
}

cmd_enter() {
    local name="${1:-}"

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    exec distrobox enter \
        --name "$name"
}

cmd_run() {
    local name="${1:-}"

    [[ -n "$name" ]] \
        || die "container name required"

    shift || true

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    (($# > 0)) \
        || die "command required"

    exec distrobox enter \
        --name "$name" \
        -- "$@"
}

cmd_stop() {
    local name="${1:-}"

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    distrobox stop \
        --yes \
        "$name"
}

cmd_remove() {
    local force=false
    local name=""

    while (($#)); do
        case "$1" in
            --force)
                force=true
                ;;

            -h|--help)
                echo "Usage: wsbox remove --force NAME"
                return 0
                ;;

            -*)
                die "unknown remove option: $1"
                ;;

            *)
                [[ -z "$name" ]] \
                    || die "only one container may be removed at a time"

                name="$1"
                ;;
        esac

        shift
    done

    require_managed "$name"

    [[ "$force" == true ]] \
        || die "managed container removal requires --force"

    container_exists "$name" \
        || die "container does not exist: $name"

    distrobox rm \
        --force \
        --yes \
        "$name"

    echo \
        "Managed definition and custom HOME were kept. Use 'wsbox apply $name' to recreate it."
}

cmd_recreate() {
    local name="${1:-}"

    require_managed "$name"

    distrobox assemble create \
        --replace \
        --file "$manifest" \
        --name "$name"
}

show_managed_exports() {
    local name="$1" alias source state launcher

    printf '%-16s %-16s %-18s %-52s %s\n' \
        BOX APP STATE SOURCE HOST_LAUNCHER

    while IFS= read -r alias; do
        [[ -n "$alias" ]] || continue
        source="$(export_source "$name" "$alias")"

        if container_exists "$name"; then
            state="$(export_state "$name" "$source")"
        else
            state="container-missing"
        fi

        launcher="$(export_host_path "$name" "$source")"
        printf '%-16s %-16s %-18s %-52s %s\n' \
            "$name" "$alias" "$state" "$source" "$launcher"
    done < <(export_aliases "$name")
}

cmd_apps() {
    local name="${1:-}" box

    if [[ -n "$name" ]]; then
        require_managed "$name"
        show_managed_exports "$name"

        if container_exists "$name"; then
            echo
            echo "Available desktop files in $name:"
            container_exec "$name" find \
                /usr/share/applications \
                -maxdepth 1 \
                -type f \
                -name '*.desktop' \
                -printf '%f\n' \
                2>/dev/null \
                | sort
        fi
        return 0
    fi

    while IFS= read -r box; do
        [[ -n "$box" ]] || continue
        show_managed_exports "$box"
    done < <(managed_boxes)
}

cmd_export() {
    local name="${1:-}" alias="${2:-}"

    require_managed "$name"
    [[ -n "$alias" ]] || die "managed app alias required"
    [[ $# -eq 2 ]] || die "Usage: wsbox export NAME APP"
    export_one "$name" "$alias"
}

cmd_unexport() {
    local name="${1:-}" alias="${2:-}"

    require_managed "$name"
    [[ -n "$alias" ]] || die "managed app alias required"
    [[ $# -eq 2 ]] || die "Usage: wsbox unexport NAME APP"
    unexport_one "$name" "$alias"
}

main() {
    ensure_base

    local cmd="${1:-}"

    if [[ -z "$cmd" ]]; then
        usage
        exit 0
    fi

    shift || true

    case "$cmd" in
        list)
            cmd_list "$@"
            ;;

        status)
            cmd_status "$@"
            ;;

        check)
            cmd_check "$@"
            ;;

        dry-run)
            cmd_dry_run "$@"
            ;;

        apply)
            cmd_apply "$@"
            ;;

        create)
            cmd_create "$@"
            ;;

        enter)
            cmd_enter "$@"
            ;;

        run)
            cmd_run "$@"
            ;;

        stop)
            cmd_stop "$@"
            ;;

        remove|rm)
            cmd_remove "$@"
            ;;

        recreate)
            cmd_recreate "$@"
            ;;

        apps)
            cmd_apps "$@"
            ;;

        export)
            cmd_export "$@"
            ;;

        unexport)
            cmd_unexport "$@"
            ;;

        -h|--help|help)
            usage
            ;;

        *)
            die "unknown command: $cmd"
            ;;
    esac
}

main "$@"
