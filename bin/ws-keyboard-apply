#!/usr/bin/env bash
set -euo pipefail

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"
settings="$repo/config/keyboard/settings.conf"
state_dir="$repo/state/keyboard"
backup="$state_dir/gsettings-backup.tsv"

[[ -r "$settings" ]] || { echo "ws-keyboard-apply: missing $settings" >&2; exit 66; }
# shellcheck disable=SC1090
source "$settings"

[[ "${PROFILE:-}" == "macos" ]] || { echo "unsupported PROFILE=${PROFILE:-unset}" >&2; exit 64; }
[[ "${PC_MODIFIER_LAYOUT:-semantic}" == "semantic" ]] || {
    echo "only PC_MODIFIER_LAYOUT=semantic is implemented" >&2
    exit 64
}

schema_has_key() {
    local schema="$1" key="$2"
    gsettings range "$schema" "$key" >/dev/null 2>&1
}

backup_key() {
    local schema="$1" key="$2"
    if schema_has_key "$schema" "$key"; then
        printf '%s\t%s\t%s\n' "$schema" "$key" "$(gsettings get "$schema" "$key")"
    fi
}

backup_once() {
    mkdir -p "$state_dir"
    [[ -f "$backup" ]] && return

    local tmp="$backup.tmp"
    : > "$tmp"
    backup_key org.gnome.desktop.wm.keybindings switch-applications >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings switch-applications-backward >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings switch-group >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings switch-group-backward >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings minimize >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings toggle-fullscreen >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings show-desktop >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings switch-to-workspace-left >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings switch-to-workspace-right >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings switch-input-source >> "$tmp"
    backup_key org.gnome.desktop.wm.keybindings switch-input-source-backward >> "$tmp"
    backup_key org.gnome.shell.keybindings toggle-overview >> "$tmp"
    backup_key org.gnome.shell.keybindings toggle-application-view >> "$tmp"
    backup_key org.gnome.shell.keybindings toggle-message-tray >> "$tmp"
    backup_key org.gnome.shell.keybindings toggle-quick-settings >> "$tmp"
    backup_key org.gnome.shell.keybindings focus-active-notification >> "$tmp"
    backup_key org.gnome.shell.keybindings switch-to-application-1 >> "$tmp"
    backup_key org.gnome.shell.keybindings switch-to-application-2 >> "$tmp"
    backup_key org.gnome.shell.keybindings switch-to-application-3 >> "$tmp"
    backup_key org.gnome.shell.keybindings switch-to-application-4 >> "$tmp"
    backup_key org.gnome.shell.keybindings switch-to-application-5 >> "$tmp"
    backup_key org.gnome.shell.keybindings switch-to-application-6 >> "$tmp"
    backup_key org.gnome.shell.keybindings switch-to-application-7 >> "$tmp"
    backup_key org.gnome.shell.keybindings switch-to-application-8 >> "$tmp"
    backup_key org.gnome.shell.keybindings switch-to-application-9 >> "$tmp"
    if schema_has_key org.gnome.shell.extensions.dash-to-dock hot-keys; then
        backup_key org.gnome.shell.extensions.dash-to-dock hot-keys >> "$tmp"
    fi
    backup_key org.gnome.shell.keybindings screenshot >> "$tmp"
    backup_key org.gnome.shell.keybindings show-screenshot-ui >> "$tmp"
    backup_key org.gnome.settings-daemon.plugins.media-keys screensaver >> "$tmp"
    mv "$tmp" "$backup"
    echo "Saved original GNOME shortcuts: $backup"
}

set_key() {
    local schema="$1" key="$2" value="$3"
    if schema_has_key "$schema" "$key"; then
        gsettings set "$schema" "$key" "$value"
        printf 'set %-48s %s\n' "$schema:$key" "$value"
    else
        echo "warning: missing GSettings key $schema $key" >&2
    fi
}

link_repo_file() {
    local src="$1" dst="$2"
    mkdir -p "$(dirname "$dst")"

    if [[ -L "$dst" ]]; then
        if [[ "$(readlink -f "$dst")" == "$(readlink -f "$src")" ]]; then
            return
        fi
        echo "refusing to replace foreign symlink: $dst" >&2
        return 1
    fi
    if [[ -e "$dst" ]]; then
        echo "refusing to replace existing file: $dst" >&2
        return 1
    fi
    ln -s "$src" "$dst"
    echo "linked $dst -> $src"
}

restore_gsettings() {
    [[ -f "$backup" ]] || { echo "backup does not exist: $backup" >&2; exit 1; }
    systemctl --user disable --now xremap.service >/dev/null 2>&1 || true
    while IFS=$'\t' read -r schema key value; do
        [[ -n "$schema" && -n "$key" ]] || continue
        if schema_has_key "$schema" "$key"; then
            gsettings set "$schema" "$key" "$value"
            echo "restored $schema:$key"
        fi
    done < "$backup"
    echo "GNOME shortcuts restored. xremap service disabled."
}

if [[ "${1:-}" == "--restore" ]]; then
    restore_gsettings
    exit 0
fi

if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* ]]; then
    echo "ws-keyboard-apply: current desktop is not GNOME: ${XDG_CURRENT_DESKTOP:-unset}" >&2
    exit 69
fi

# Runtime paths are symlinks only. Sources stay in workstation-config.
# Creating them is safe even if the runtime preflight below fails.
link_repo_file "$repo/bin/ws-keyboard" "$HOME/.local/bin/ws-keyboard"
link_repo_file "$repo/bin/ws-keyboard-apply" "$HOME/.local/bin/ws-keyboard-apply"
link_repo_file "$repo/bin/ws-keyboard-status" "$HOME/.local/bin/ws-keyboard-status"
link_repo_file "$repo/bin/ws-xremap" "$HOME/.local/bin/ws-xremap"
link_repo_file "$repo/systemd/user/xremap.service" "$HOME/.config/systemd/user/xremap.service"
systemctl --user daemon-reload

# Full preflight BEFORE changing GNOME shortcuts. Some bindings (notably
# Ctrl+Left/Right for workspaces) depend on xremap, so a partial apply is worse
# than no apply.
preflight_failed=false

# Require the exact GNOME schema keys used by this profile. Do not silently
# produce a partial profile on a different GNOME build.
for spec in \
    "org.gnome.desktop.wm.keybindings|switch-applications" \
    "org.gnome.desktop.wm.keybindings|switch-applications-backward" \
    "org.gnome.desktop.wm.keybindings|switch-group" \
    "org.gnome.desktop.wm.keybindings|switch-group-backward" \
    "org.gnome.desktop.wm.keybindings|minimize" \
    "org.gnome.desktop.wm.keybindings|toggle-fullscreen" \
    "org.gnome.desktop.wm.keybindings|show-desktop" \
    "org.gnome.desktop.wm.keybindings|switch-to-workspace-left" \
    "org.gnome.desktop.wm.keybindings|switch-to-workspace-right" \
    "org.gnome.desktop.wm.keybindings|switch-input-source" \
    "org.gnome.desktop.wm.keybindings|switch-input-source-backward" \
    "org.gnome.shell.keybindings|toggle-overview" \
    "org.gnome.shell.keybindings|toggle-application-view" \
    "org.gnome.shell.keybindings|toggle-message-tray" \
    "org.gnome.shell.keybindings|toggle-quick-settings" \
    "org.gnome.shell.keybindings|focus-active-notification" \
    "org.gnome.shell.keybindings|switch-to-application-1" \
    "org.gnome.shell.keybindings|switch-to-application-2" \
    "org.gnome.shell.keybindings|switch-to-application-3" \
    "org.gnome.shell.keybindings|switch-to-application-4" \
    "org.gnome.shell.keybindings|switch-to-application-5" \
    "org.gnome.shell.keybindings|switch-to-application-6" \
    "org.gnome.shell.keybindings|switch-to-application-7" \
    "org.gnome.shell.keybindings|switch-to-application-8" \
    "org.gnome.shell.keybindings|switch-to-application-9" \
    "org.gnome.shell.keybindings|screenshot" \
    "org.gnome.shell.keybindings|show-screenshot-ui" \
    "org.gnome.settings-daemon.plugins.media-keys|screensaver"
do
    schema="${spec%%|*}"
    key="${spec#*|}"
    schema_has_key "$schema" "$key" || {
        echo "missing required GSettings key: $schema $key" >&2
        preflight_failed=true
    }
done

command -v xremap >/dev/null 2>&1 || { echo "xremap not found in PATH" >&2; preflight_failed=true; }
id -nG | tr ' ' '\n' | grep -Fxq input || { echo "user is not in input group" >&2; preflight_failed=true; }
[[ -e /dev/uinput && -w /dev/uinput ]] || { echo "/dev/uinput missing or not writable" >&2; preflight_failed=true; }
busctl --user call org.gnome.Shell /com/k0kubun/Xremap com.k0kubun.Xremap WMClasses >/dev/null 2>&1 || {
    echo "GNOME xremap bridge unavailable" >&2
    preflight_failed=true
}
if [[ "$preflight_failed" == true ]]; then
    echo >&2
    echo "No GNOME shortcuts were changed." >&2
    echo "Run: $repo/bin/ws-keyboard-status" >&2
    exit 69
fi

# Prove the service can actually start while GNOME still has its old bindings.
# If xremap/config/runtime is broken, exit without touching GNOME shortcuts.
systemctl --user enable xremap.service >/dev/null
if ! systemctl --user restart xremap.service; then
    echo "xremap service failed to start; no GNOME shortcuts were changed." >&2
    exit 70
fi

backup_once

# From this point onward, applying GNOME settings is transactional. If any
# gsettings operation fails, restore the original snapshot and stop/disable
# xremap so we do not leave a half-applied keyboard profile behind.
apply_started=true
apply_succeeded=false

rollback_apply() {
    local rc="$?"

    if [[ "$apply_started" == true && "$apply_succeeded" != true ]]; then
        echo >&2
        echo "ws-keyboard-apply: apply failed; restoring original GNOME shortcuts" >&2

        while IFS=$'\t' read -r schema key value; do
            [[ -n "$schema" && -n "$key" ]] || continue
            if schema_has_key "$schema" "$key"; then
                gsettings set "$schema" "$key" "$value" >/dev/null 2>&1 || true
            fi
        done < "$backup"

        systemctl --user disable --now xremap.service >/dev/null 2>&1 || true
        echo "ws-keyboard-apply: rollback completed" >&2
    fi

    exit "$rc"
}

trap rollback_apply EXIT

# Application / window switching
set_key org.gnome.desktop.wm.keybindings switch-applications "['<Super>Tab']"
set_key org.gnome.desktop.wm.keybindings switch-applications-backward "['<Shift><Super>Tab']"
set_key org.gnome.desktop.wm.keybindings switch-group "['<Super>Above_Tab', '<Control>Down']"
set_key org.gnome.desktop.wm.keybindings switch-group-backward "['<Shift><Super>Above_Tab']"

# Window actions
set_key org.gnome.desktop.wm.keybindings minimize "['<Super>m']"
set_key org.gnome.desktop.wm.keybindings toggle-fullscreen "['<Control><Super>f']"
set_key org.gnome.desktop.wm.keybindings show-desktop "['F11']"

# Workspaces. Physical Ctrl+Left/Right are translated by xremap into these
# private chords, leaving emitted application Ctrl+Left/Right unclaimed by GNOME.
set_key org.gnome.desktop.wm.keybindings switch-to-workspace-left "['<Control><Alt><Super>Left']"
set_key org.gnome.desktop.wm.keybindings switch-to-workspace-right "['<Control><Alt><Super>Right']"

# Input sources
set_key org.gnome.desktop.wm.keybindings switch-input-source "['<Control>space']"
set_key org.gnome.desktop.wm.keybindings switch-input-source-backward "['<Control><Alt>space']"

# Free GNOME Shell Super-letter shortcuts that conflict with macOS
# application semantics. Without this, GNOME Shell consumes the event before
# xremap/Ghostty can see it.
set_key org.gnome.shell.keybindings toggle-application-view "[]"
set_key org.gnome.shell.keybindings toggle-message-tray "[]"
set_key org.gnome.shell.keybindings toggle-quick-settings "[]"
set_key org.gnome.shell.keybindings focus-active-notification "[]"

# Free Super+number shortcuts from GNOME Shell / Ubuntu Dock.
# This is required for macOS-style Shift+Super+3/4/5 screenshots and
# also leaves Command/Win+number available to applications.
set_key org.gnome.shell.keybindings switch-to-application-1 "[]"
set_key org.gnome.shell.keybindings switch-to-application-2 "[]"
set_key org.gnome.shell.keybindings switch-to-application-3 "[]"
set_key org.gnome.shell.keybindings switch-to-application-4 "[]"
set_key org.gnome.shell.keybindings switch-to-application-5 "[]"
set_key org.gnome.shell.keybindings switch-to-application-6 "[]"
set_key org.gnome.shell.keybindings switch-to-application-7 "[]"
set_key org.gnome.shell.keybindings switch-to-application-8 "[]"
set_key org.gnome.shell.keybindings switch-to-application-9 "[]"
if schema_has_key org.gnome.shell.extensions.dash-to-dock hot-keys; then
    set_key org.gnome.shell.extensions.dash-to-dock hot-keys "false"
fi

# Overview / Spotlight-style search
set_key org.gnome.shell.keybindings toggle-overview "['<Super>space', '<Control>Up']"

# Screenshots
set_key org.gnome.shell.keybindings screenshot "['<Shift><Super>3']"
set_key org.gnome.shell.keybindings show-screenshot-ui "['<Shift><Super>4', '<Shift><Super>5']"

# Lock screen. Some GNOME builds expose this as a string, others as a string array.
if schema_has_key org.gnome.settings-daemon.plugins.media-keys screensaver; then
    type="$(gsettings range org.gnome.settings-daemon.plugins.media-keys screensaver 2>/dev/null | head -n1 || true)"
    if [[ "$type" == *"type s"* ]]; then
        gsettings set org.gnome.settings-daemon.plugins.media-keys screensaver "'<Control><Super>q'"
    else
        gsettings set org.gnome.settings-daemon.plugins.media-keys screensaver "['<Control><Super>q']"
    fi
fi

apply_succeeded=true
trap - EXIT

echo "xremap service is active and GNOME shortcuts were applied."
