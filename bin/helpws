#!/usr/bin/env sh
set -eu

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"
micro_cfg="$repo/config/micro-help"
topic="${1:-terminal}"

open_md() {
    MICRO_CONFIG_HOME="$micro_cfg" exec micro -readonly true "$1"
}

case "$topic" in
    terminal|term) open_md "$repo/docs/terminal.md" ;;
    ghostty|fish) open_md "$repo/docs/terminal.md" ;;
    keyboard|keys) open_md "$repo/docs/keyboard.md" ;;
    workstation|system|baseline) open_md "$repo/docs/workstation.md" ;;
    touchbar|touch-bar) open_md "$repo/docs/touchbar.md" ;;
    gnome|desktop) open_md "$repo/docs/gnome.md" ;;
    rebuild|reinstall|install) open_md "$repo/docs/rebuild.md" ;;
    roadmap|plans) open_md "$repo/docs/roadmap.md" ;;
    distrobox|box|boxes|wsbox) open_md "$repo/docs/plans/development.md" ;;
    plan-t2) open_md "$repo/docs/plans/t2-optional.md" ;;
    plan-gnome) open_md "$repo/docs/plans/gnome.md" ;;
    plan-flatpak) open_md "$repo/docs/plans/flatpak.md" ;;
    plan-dev) open_md "$repo/docs/plans/development.md" ;;
    plan-windows) open_md "$repo/docs/plans/windows-gaming.md" ;;
    plan-virt) open_md "$repo/docs/plans/virtualization-unreal.md" ;;
    plan-final) open_md "$repo/docs/plans/finalization.md" ;;
    plan-nix) open_md "$repo/docs/plans/nix-migration.md" ;;
    man)
        page="${2:-ws-terminal}"
        tmp="$(mktemp "${TMPDIR:-/tmp}/helpws.XXXXXX")"
        trap 'rm -f "$tmp"' EXIT HUP INT TERM
        PAGER=cat MANPAGER=cat man "$page" | col -bx > "$tmp"
        MICRO_CONFIG_HOME="$micro_cfg" micro -readonly true "$tmp"
        ;;
    -h|--help|help)
        cat <<'USAGE'
Usage: helpws [topic]

Core:
  terminal         Ghostty + Fish handbook
  keyboard         macOS-style keyboard layer
  workstation      Current workstation baseline
  touchbar         Touch Bar implementation notes
  gnome            GNOME desktop status / baseline work
  rebuild          Reinstall to current baseline
  roadmap          Remaining workstation roadmap
  distrobox        Managed Distrobox / Podman layer

Plans:
  plan-t2          T2 optional / power / auth
  plan-gnome       GNOME visual / input / portals
  plan-flatpak     Flatpak desktop apps
  plan-dev         Distrobox / Podman managed layer (completed)
  plan-windows     Wine / Steam / Proton
  plan-virt        KVM / libvirt / Unreal Engine
  plan-final       Backup / inventory / finalization
  plan-nix         Nix + home-manager migration

Other:
  man PAGE         Open generated man page in Micro
USAGE
        ;;
    *)
        echo "Unknown topic: $topic" >&2
        echo "Run: helpws --help" >&2
        exit 2
        ;;
esac
