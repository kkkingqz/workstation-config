#!/usr/bin/env sh
set -eu

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"
micro_cfg="$repo/config/micro-help"
topic="${1:-terminal}"

open_md() {
    MICRO_CONFIG_HOME="$micro_cfg" exec micro -readonly true "$1"
}

case "$topic" in
    terminal|term)
        open_md "$repo/docs/terminal.md"
        ;;
    ghostty|fish|keys)
        # These topics live in the terminal handbook. Open the same source;
        # Ctrl+F can be used to jump to the requested section.
        open_md "$repo/docs/terminal.md"
        ;;
    workstation|system|baseline)
        open_md "$repo/docs/workstation.md"
        ;;
    man)
        page="${2:-ws-terminal}"
        tmp="$(mktemp "${TMPDIR:-/tmp}/helpws.XXXXXX")"
        trap 'rm -f "$tmp"' EXIT HUP INT TERM
        PAGER=cat MANPAGER=cat man "$page" | col -bx > "$tmp"
        MICRO_CONFIG_HOME="$micro_cfg" micro -readonly true "$tmp"
        ;;
    -h|--help|help)
        cat <<'USAGE'
Usage: helpws [topic]

Topics:
  terminal       Ghostty + Fish handbook (default)
  ghostty        Terminal handbook; use Ctrl+F for Ghostty
  fish           Terminal handbook; use Ctrl+F for Fish
  keys           Terminal handbook; use Ctrl+F for hotkeys
  workstation    Full workstation baseline
  man PAGE       Open a generated man page in Micro

Examples:
  helpws
  helpws workstation
  helpws man ws-terminal
USAGE
        ;;
    *)
        echo "Unknown topic: $topic" >&2
        echo "Run: helpws --help" >&2
        exit 2
        ;;
esac
