#!/usr/bin/env bash
set -u
set -o pipefail

# Full read-only audit for the wsconfig repository and the currently
# installed GNOME/Wayland macOS-style keyboard/workstation layer.
#
# Nothing is deleted, modified, staged, committed, enabled or restarted.
# Exit codes:
#   0 = no FAIL (warnings allowed)
#   1 = one or more FAIL
#   2 = warnings in --strict mode, but no FAIL

repo="${WSCONFIG:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
strict=false

usage() {
    cat <<'USAGE'
Usage:
  ws-workstation-verify-v4.sh [--strict] [--repo PATH]
  ws-workstation-verify-v4.sh [PATH]          # compatibility shorthand

Options:
  --strict       WARN also makes the final result non-zero (exit 2)
  --repo PATH    repository to inspect
  -h, --help     show this help

The script is read-only. It does not run git add/commit, does not delete files,
and does not change GNOME/systemd settings.
USAGE
}

while (($#)); do
    case "$1" in
        --strict)
            strict=true
            shift
            ;;
        --repo)
            [[ $# -ge 2 ]] || { echo "--repo requires PATH" >&2; exit 64; }
            repo="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 64
            ;;
        *)
            repo="$1"
            shift
            ;;
    esac
done

repo="${repo%/}"

pass_n=0
warn_n=0
fail_n=0
info_n=0
cleanup_n=0

declare -a cleanup_items=()
declare -a git_remove_candidates=()

pass() { ((pass_n++)); printf '  PASS  %s\n' "$*"; }
warn() { ((warn_n++)); printf '  WARN  %s\n' "$*"; }
fail() { ((fail_n++)); printf '  FAIL  %s\n' "$*"; }
info() { ((info_n++)); printf '  INFO  %s\n' "$*"; }
declare -A cleanup_seen=()

cleanup() {
    local item="$*"
    if [[ -n "${cleanup_seen[$item]:-}" ]]; then
        return
    fi
    cleanup_seen["$item"]=1
    ((cleanup_n++))
    cleanup_items+=("$item")
    printf '  CLEAN %s\n' "$item"
}

section() {
    echo
    echo "$1"
    printf '%s\n' '------------------------------------------------------------------------'
}

have() { command -v "$1" >/dev/null 2>&1; }

q() { printf '%q' "$1"; }

contains() {
    local file="$1" regex="$2" label="$3"
    if [[ -r "$file" ]] && grep -Eq -- "$regex" "$file"; then
        pass "$label"
    else
        fail "$label"
    fi
}

contains_literal() {
    local file="$1" literal="$2" label="$3"
    if [[ -r "$file" ]] && grep -Fq -- "$literal" "$file"; then
        pass "$label"
    else
        fail "$label"
    fi
}

is_tracked() {
    git -C "$repo" ls-files --error-unmatch -- "$1" >/dev/null 2>&1
}

gget() {
    gsettings get "$1" "$2" 2>/dev/null || true
}

gcontains() {
    local schema="$1" key="$2" needle="$3" label="$4"
    local value
    value="$(gget "$schema" "$key")"
    if [[ "$value" == *"$needle"* ]]; then
        pass "$label"
    else
        fail "$label — got: ${value:-MISSING}"
    fi
}

# The extension list is built from gnome/gnome-extensions.nix.
ext_list_file="$HOME/.local/share/workstation/gnome/extensions"
ext_list() {
    [[ -r "$ext_list_file" ]] || return 0
    awk -v s="${1:-}" '!/^#/ && NF >= 2 && (s == "" || $2 == s) { print $1 }' "$ext_list_file"
}

extension_active() {
    local uuid="$1" label="$2" out
    if ! have gnome-extensions; then
        fail "gnome-extensions binary missing; cannot check $label"
        return
    fi
    out="$(gnome-extensions info "$uuid" 2>/dev/null || true)"
    if grep -Eq 'State:[[:space:]]+ACTIVE|Enabled:[[:space:]]+Yes' <<<"$out"; then
        pass "$label ($uuid)"
    else
        fail "$label ($uuid) not active"
    fi
}

locale1_prop() {
    busctl get-property \
        org.freedesktop.locale1 \
        /org/freedesktop/locale1 \
        org.freedesktop.locale1 \
        "$1" 2>/dev/null \
      | sed -E 's/^s "(.*)"$/\1/'
}

compare_file() {
    local source="$1" runtime="$2" label="$3"
    if [[ ! -r "$source" ]]; then
        fail "$label — repo source missing: $source"
    elif [[ ! -r "$runtime" ]]; then
        fail "$label — runtime file missing: $runtime"
    elif cmp -s -- "$source" "$runtime"; then
        pass "$label"
    else
        warn "$label — runtime differs from repo source"
    fi
}

print_cmd_array() {
    local prefix="$1"; shift
    printf '  %s' "$prefix"
    local x
    for x in "$@"; do
        printf ' %q' "$x"
    done
    printf '\n'
}

echo "Workstation full verification v4"
echo "Repo: $repo"
echo "Time: $(date --iso-8601=seconds 2>/dev/null || date)"
echo "Mode: READ-ONLY"

section "1. Host / session"

model="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
[[ "$model" == "MacBookPro16,1" ]] \
    && pass "hardware: $model" \
    || warn "hardware: ${model:-unknown} (expected MacBookPro16,1 for this workstation)"

desktop="${XDG_CURRENT_DESKTOP:-unknown}"
[[ "$desktop" == *GNOME* ]] && pass "desktop: $desktop" || fail "desktop is not GNOME: $desktop"

session="${XDG_SESSION_TYPE:-unknown}"
[[ "$session" == "wayland" ]] && pass "session: Wayland" || warn "session: $session"

if have gnome-shell; then
    gv="$(gnome-shell --version 2>/dev/null || true)"
    [[ -n "$gv" ]] && info "GNOME: $gv" || warn "unable to read GNOME Shell version"
else
    fail "gnome-shell binary missing"
fi

kernel="$(uname -r)"
[[ "$kernel" == *t2* ]] && pass "T2 kernel: $kernel" || warn "kernel is not T2-labelled: $kernel"

section "2. Repository identity / Git integrity"

if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    fail "not a Git repository: $repo"
    echo
    echo "RESULT: FAILED"
    exit 1
fi
pass "Git repository exists"

branch="$(git -C "$repo" branch --show-current 2>/dev/null || true)"
[[ "$branch" == "main" ]] && pass "branch: main" || warn "branch: ${branch:-detached}"

origin="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
[[ "$origin" == *"kkkingqz/wsconfig"* ]] \
    && pass "origin: $origin" \
    || warn "unexpected origin: ${origin:-none}"

head="$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)"
info "HEAD: ${head:-unknown}"

if git -C "$repo" diff --check >/dev/null 2>&1; then
    pass "git diff --check"
else
    fail "git diff --check found whitespace errors"
fi

if git -C "$repo" diff --cached --check >/dev/null 2>&1; then
    pass "git diff --cached --check"
else
    fail "git diff --cached --check found whitespace errors"
fi

if git -C "$repo" fsck --no-progress --full >/dev/null 2>&1; then
    pass "git fsck --full"
else
    fail "git fsck reports repository object errors"
fi

status_porcelain="$(git -C "$repo" status --porcelain=v1 --untracked-files=all 2>/dev/null || true)"
if [[ -z "$status_porcelain" ]]; then
    pass "working tree clean"
else
    warn "working tree has staged/modified/untracked files"
    printf '%s\n' "$status_porcelain" | sed 's/^/        /'
fi

section "3. Repository hygiene / junk detection"

weird_found=false
while IFS= read -r -d '' path; do
    bad=false
    reason=""

    if [[ "$path" == *$'\n'* || "$path" == *$'\r'* || "$path" == *$'\t'* ]]; then
        bad=true; reason="contains control whitespace"
    elif [[ "$path" =~ (^|/)[[:space:]] || "$path" =~ [[:space:]]$ ]]; then
        bad=true; reason="leading/trailing whitespace"
    elif [[ "$path" == *'\\'* ]]; then
        bad=true; reason="contains backslash"
    fi

    if [[ "$bad" == true ]]; then
        weird_found=true
        cleanup "tracked suspicious filename ($(q "$path")): $reason"
        git_remove_candidates+=("$path")
    fi
done < <(git -C "$repo" ls-files -z)
[[ "$weird_found" == false ]] && pass "no tracked filenames with control/trailing whitespace/backslashes"

zero_found=false
while IFS= read -r -d '' path; do
    full="$repo/$path"
    if [[ -f "$full" && ! -s "$full" ]]; then
        zero_found=true
        cleanup "tracked zero-byte file: $(q "$path")"
        git_remove_candidates+=("$path")
    fi
done < <(git -C "$repo" ls-files -z)
[[ "$zero_found" == false ]] && pass "no tracked zero-byte regular files"

junk_found=false
while IFS= read -r -d '' path; do
    base="${path##*/}"
    case "$base" in
        *~|*.bak|*.backup|*.orig|*.rej|*.swp|*.swo|*.tmp|*.temp|.DS_Store|Thumbs.db|*.pyc)
            junk_found=true
            cleanup "tracked backup/editor/temp candidate: $(q "$path")"
            git_remove_candidates+=("$path")
            ;;
    esac
    case "$path" in
        fix-keyboard-layer-v*.sh|*/fix-keyboard-layer-v*.sh|rollback-keyboard-layer-v*.sh|*/rollback-keyboard-layer-v*.sh)
            junk_found=true
            cleanup "tracked one-shot migration/fix script candidate: $(q "$path")"
            ;;
    esac
done < <(git -C "$repo" ls-files -z)
[[ "$junk_found" == false ]] && pass "no obvious tracked editor/backup/one-shot junk"

runtime_tracked=false
for p in state runtime; do
    if git -C "$repo" ls-files -- "$p" | grep -q .; then
        runtime_tracked=true
        fail "generated/runtime path is tracked: $p"
    fi
done
[[ "$runtime_tracked" == false ]] && pass "runtime/generated directories are not tracked"

for ignored in runtime/probe $(for uuid in $(ext_list local); do
    [[ -d "$repo/gnome/extensions/$uuid/schemas" ]] \
        && echo "gnome/extensions/$uuid/schemas/gschemas.compiled"
done); do
    if git -C "$repo" check-ignore -q -- "$ignored"; then
        pass ".gitignore covers: $ignored"
    else
        warn ".gitignore does not cover expected runtime path: $ignored"
    fi
done

broken_link=false
while IFS= read -r -d '' p; do
    if [[ -L "$p" && ! -e "$p" ]]; then
        broken_link=true
        fail "broken symlink in repo tree: $(q "${p#$repo/}") -> $(q "$(readlink "$p")")"
    fi
done < <(find "$repo" -path "$repo/.git" -prune -o -type l -print0 2>/dev/null)
[[ "$broken_link" == false ]] && pass "no broken symlinks inside repository tree"

large_found=false
while IFS= read -r -d '' path; do
    full="$repo/$path"
    [[ -f "$full" ]] || continue
    size="$(stat -c %s "$full" 2>/dev/null || echo 0)"
    if (( size > 5 * 1024 * 1024 )); then
        large_found=true
        warn "tracked file >5 MiB: $path ($size bytes)"
    fi
done < <(git -C "$repo" ls-files -z)
[[ "$large_found" == false ]] && pass "no tracked files larger than 5 MiB"

if git -C "$repo" grep -nEI -- \
    '-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{20,}' \
    -- . ':(exclude)docs/*.md' >/tmp/ws-verify-secret.$$ 2>/dev/null; then
    warn "possible secret/private-key marker in tracked files (inspect manually):"
    sed 's/^/        /' /tmp/ws-verify-secret.$$
else
    pass "no obvious private-key/GitHub/AWS secret markers in tracked non-doc files"
fi
rm -f /tmp/ws-verify-secret.$$

# xremap.yml launches ws-input-source as "@repo@/bin/ws-input-source";
# keyboard/xremap.nix substitutes the checkout path in the store build.
expected_input_helper="$repo/bin/ws-input-source"
if grep -qE '"/[^"]*/ws-input-source"' "$repo/keyboard/xremap.yml" 2>/dev/null; then
    fail "xremap.yml has an absolute ws-input-source path; use @repo@/bin/ws-input-source"
elif ! grep -qF '"@repo@/bin/ws-input-source"' "$repo/keyboard/xremap.yml" 2>/dev/null; then
    fail "xremap.yml contains no @repo@/bin/ws-input-source launch path"
else
    pass "xremap.yml launches ws-input-source through @repo@"
fi
xremap_env="$(systemctl --user show -P Environment xremap.service 2>/dev/null || true)"
xremap_cfg="$(tr ' ' '\n' <<<"$xremap_env" | sed -n 's/^XREMAP_CONFIG=//p')"
xremap_env_bin="$(tr ' ' '\n' <<<"$xremap_env" | sed -n 's/^XREMAP_BIN=//p')"
if [[ "$xremap_cfg" != /nix/store/* || ! -r "$xremap_cfg" ]]; then
    fail "xremap.service has no store XREMAP_CONFIG (${xremap_cfg:-unset}); run ws switch"
elif grep -q '@repo@' "$xremap_cfg"; then
    fail "xremap store config still contains @repo@: $xremap_cfg"
elif ! grep -qF "\"$expected_input_helper\"" "$xremap_cfg"; then
    fail "xremap store config does not launch $(q "$expected_input_helper")"
elif [[ "$(sed "s|@repo@|$repo|g" "$repo/keyboard/xremap.yml" | sha256sum)" != "$(sha256sum < "$xremap_cfg")" ]]; then
    warn "xremap store config differs from keyboard/xremap.yml; run ws switch"
else
    pass "xremap store config matches keyboard/xremap.yml (${xremap_cfg#/nix/store/})"
fi

# The extension runs ~/.local/share/workstation/wsconfig/bin/ws-caps-led;
# home-manager links wsconfig to the checkout (facts.nix: wsconfig).
if grep -qF "'.local/share/workstation/wsconfig/bin/ws-caps-led'" \
    "$repo/gnome/extensions/workstation-input-source@local/extension.js"; then
    pass "Input Source LED helper goes through ~/.local/share/workstation/wsconfig"
else
    fail "Input Source LED helper path in extension.js is not ~/.local/share/workstation/wsconfig/bin/ws-caps-led"
fi
if [[ "$(readlink -f "$HOME/.local/share/workstation/wsconfig" 2>/dev/null)" == "$repo" ]]; then
    pass "~/.local/share/workstation/wsconfig points at this checkout"
else
    fail "~/.local/share/workstation/wsconfig does not point at $repo (wsconfig in facts.nix; ws switch)"
fi

current_home_prefix="${HOME%/}/"
other_hardcoded_home="$(git -C "$repo" grep -nF "$current_home_prefix" -- \
    ':!docs/**' \
    ':!bin/ws-workstation-verify' \
    2>/dev/null || true)"
if [[ -n "$other_hardcoded_home" ]]; then
    warn "unexpected hard-coded current HOME paths found outside validated helper locations:"
    printf '%s\n' "$other_hardcoded_home" | sed 's/^/        /'
else
    pass "no unexpected hard-coded current HOME paths outside validated helper locations"
fi

conflict_hits="$(git -C "$repo" grep -nE '^(<<<<<<<|=======|>>>>>>>)' -- . 2>/dev/null || true)"
[[ -z "$conflict_hits" ]] \
    && pass "no merge-conflict markers in tracked files" \
    || { fail "merge-conflict markers found"; printf '%s\n' "$conflict_hits" | sed 's/^/        /'; }

crlf_found=false
while IFS= read -r -d '' path; do
    full="$repo/$path"
    [[ -f "$full" ]] || continue
    case "$path" in
        *.sh|*.fish|*.yml|*.yaml|*.toml|*.service|*.rules|*.md|*.ghostty|*.json)
            if LC_ALL=C grep -q $'\r$' "$full" 2>/dev/null; then
                crlf_found=true
                warn "CRLF line endings: $path"
            fi
            ;;
    esac
done < <(git -C "$repo" ls-files -z)
[[ "$crlf_found" == false ]] && pass "no CRLF in tracked config/script/docs files"

section "4. home-manager files / checkout"

# The active home-manager generation is the list of the user layer: every
# file it links (bin/, fish, ghostty, configs built from Nix) must resolve to
# the same target from $HOME. Targets in the checkout must be tracked, and
# those in bin/ executable in Git (they are run through the link).
hm_gen="$(readlink -f "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager" 2>/dev/null || true)"
hm_files="$(readlink -f "$hm_gen/home-files" 2>/dev/null || true)"
if [[ -n "$hm_gen" && -e "$hm_gen/activate" && -d "$hm_files" ]]; then
    pass "home-manager generation active: ${hm_gen#/nix/store/}"
    hm_ok=0
    hm_repo=0
    while IFS= read -r -d '' entry; do
        rel="${entry#"$hm_files"/}"
        want="$(readlink -f -- "$entry" 2>/dev/null || true)"
        got="$(readlink -f -- "$HOME/$rel" 2>/dev/null || true)"
        if [[ -z "$want" || "$got" != "$want" ]]; then
            fail "~/$rel is not the generation's (${got:-missing}, want ${want:-broken}); ws switch"
            continue
        fi
        hm_ok=$((hm_ok + 1))
        [[ "$want" == "$repo"/* && -f "$want" ]] || continue
        hm_repo=$((hm_repo + 1))
        path="${want#"$repo"/}"
        if ! is_tracked "$path"; then
            fail "~/$rel links to untracked $path"
        elif [[ "$path" == bin/* ]]; then
            mode="$(git -C "$repo" ls-files -s -- "$path" | awk 'NR==1{print $1}')"
            [[ "$mode" == 100755 && -x "$want" ]] \
                || fail "$path linked into ~/.local/bin but not executable (Git mode ${mode:-?})"
        fi
    done < <(find "$hm_files" -mindepth 1 \( -type l -o -type f \) -print0 2>/dev/null)
    pass "home-manager files match the generation: $hm_ok ($hm_repo into the checkout)"
else
    fail "no active home-manager generation (ws switch)"
fi

section "5. Apply reproducibility"

apply="$repo/bin/ws-keyboard-apply"
contains_literal "$apply" 'bin/ws-window' "apply installs ws-window runtime link"
contains_literal "$apply" 'bin/ws-nautilus-current' "apply installs ws-nautilus-current runtime link"
contains_literal "$apply" 'bin/ws-input-source' "apply installs ws-input-source runtime link"
contains_literal "$apply" 'bin/ws-tiling-apply' "apply installs ws-tiling-apply runtime link"
contains_literal "$apply" 'ws-keyboard-install-extensions' "apply installs/reuses local GNOME extension sources"
contains_literal "$apply" 'ws-tiling-apply' "apply reapplies Tiling Assistant private bindings"
[[ -x "$repo/bin/ws-keyboard-system-apply" ]] \
    && pass "system-level keyboard/uinput/Touch Bar apply helper is executable" \
    || fail "bin/ws-keyboard-system-apply missing/not executable"
contains_literal "$repo/bin/ws-keyboard-system-apply" '"$repo/bin/ws" system apply' \
    "ws-keyboard-system-apply delegates to ws system apply (one owner of system files)"
contains_literal "$repo/bin/ws-suspend" '"$repo/bin/ws" system apply' \
    "ws-suspend apply delegates to ws system apply (one owner of system files)"


section "5.1 GNOME managed appearance"

# Declared in gnome/gnome.nix (dconf.settings, written by ws switch);
# the Nix module asserts that it does not overlap the keyboard, tiling,
# extension and display owners.
if [[ -x "$repo/bin/ws-gnome-check" ]]; then
    if "$repo/bin/ws-gnome-check" --quiet >/dev/null 2>&1; then
        pass "GNOME managed appearance/Dock profile is in sync"
    else
        fail "GNOME managed appearance/Dock profile has drift or cannot be validated (ws-gnome check)"
    fi
else
    fail "bin/ws-gnome-check is missing or not executable"
fi


section "5.2 Host Qt integration"

for pkg in qgnomeplatform-qt5 qgnomeplatform-qt6 qtwayland5 qt6-wayland; do
    if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null \
        | grep -qx 'install ok installed'; then
        pass "host Qt baseline package installed: $pkg"
    else
        fail "host Qt baseline package missing: $pkg"
    fi
done

qt_override_bad=false
for var in QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE QT_SCALE_FACTOR; do
    value="${!var:-}"
    if [[ -n "$value" ]]; then
        qt_override_bad=true
        fail "global Qt override should be unset: $var=$value"
    fi
done
[[ "$qt_override_bad" == false ]] \
    && pass "no global Qt platform/theme/scale overrides"


section "5.3 Managed Distrobox / Podman layer"

if lsmod 2>/dev/null | awk '$1 == "ntsync" { found=1 } END { exit !found }'; then
    pass "host ntsync module loaded"
else
    fail "host ntsync module not loaded"
fi

[[ -c /dev/ntsync ]] \
    && pass "/dev/ntsync character device present" \
    || fail "/dev/ntsync character device missing"

ntsync_pkgbuild="$repo/distrobox/arch/wsbox-host-ntsync/PKGBUILD"
if [[ -r "$ntsync_pkgbuild" ]]; then
    if bash -n "$ntsync_pkgbuild" >/dev/null 2>&1; then
        pass "bash syntax: distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    else
        fail "bash syntax error: distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    fi

    contains_literal \
        "$ntsync_pkgbuild" \
        'provides=("NTSYNC-MODULE")' \
        "Arch host-NTSync package provides NTSYNC-MODULE"

    readme_sum="$(sha256sum "${ntsync_pkgbuild%/*}/README.md" 2>/dev/null | cut -d' ' -f1)"
    if grep -Fq "sha256sums=(\"$readme_sum\")" "$ntsync_pkgbuild"; then
        pass "wsbox-host-ntsync PKGBUILD checksum matches README.md"
    else
        fail "wsbox-host-ntsync PKGBUILD sha256sums does not match README.md (makepkg fails; update it and pkgrel)"
    fi
fi
ntsync_hook="distrobox/arch/wsbox-host-ntsync/install-hook"
# Every hook the manifest runs: in the checkout, tracked, executable.
while IFS= read -r hook; do
    path="${hook#"$repo"/}"
    if [[ "$hook" != "$repo"/* ]]; then
        fail "hook outside the checkout: $hook"
    elif ! is_tracked "$path"; then
        fail "hook not tracked: $path"
    elif [[ "$(git -C "$repo" ls-files -s -- "$path" | awk 'NR==1{print $1}')" != 100755 || ! -x "$hook" ]]; then
        fail "hook not executable (file and Git mode 100755): $path"
    else
        pass "hook executable and tracked: $path"
    fi
done < <(sed -nE 's/^(pre_)?init_hooks="([^ "]+).*/\2/p' \
    "$HOME/.local/share/workstation/distrobox/containers.ini" 2>/dev/null | sort -u)

# Boxes whose manifest entry runs the NTSync hook.
ntsync_boxes="$(
    awk -v hook="init_hooks=\"$repo/$ntsync_hook\"" '
        /^\[/ { box = substr($0, 2, length($0) - 2) }
        $0 == hook { print box }
    ' "$HOME/.local/share/workstation/distrobox/containers.ini" 2>/dev/null
)"
if [[ -n "$ntsync_boxes" ]]; then
    pass "manifest runs $ntsync_hook in: $(echo $ntsync_boxes)"
else
    fail "no box runs $ntsync_hook (distrobox/distrobox.nix; ws switch)"
fi

for box in $ntsync_boxes; do
    if ! have podman || ! podman container exists "$box" >/dev/null 2>&1; then
        info "$box container missing; wsbox check reports it"
        continue
    fi
    if [[ "$(podman inspect -f '{{.State.Running}}' "$box" 2>/dev/null || true)" != true ]]; then
        info "$box container is not running; skipped read-only in-container NTSync checks"
        continue
    fi

    if podman exec "$box" pacman -Q wsbox-host-ntsync >/dev/null 2>&1; then
        pass "$box: wsbox-host-ntsync installed"
    else
        fail "$box: wsbox-host-ntsync missing"
    fi

    ntsync_missing="$(podman exec "$box" pacman -T NTSYNC-MODULE 2>/dev/null || true)"
    [[ -z "$ntsync_missing" ]] \
        && pass "$box: NTSYNC-MODULE dependency satisfied" \
        || fail "$box: NTSYNC-MODULE dependency unsatisfied: $ntsync_missing"

    for pkg in linux mkinitcpio mkinitcpio-busybox; do
        if podman exec "$box" pacman -Q "$pkg" >/dev/null 2>&1; then
            fail "$box: container-local kernel/initramfs package should be absent: $pkg"
        else
            pass "$box: container-local package absent: $pkg"
        fi
    done

    podman exec "$box" test -c /dev/ntsync >/dev/null 2>&1 \
        && pass "$box: /dev/ntsync visible inside running container" \
        || fail "$box: /dev/ntsync not visible inside running container"
done

# wsbox check uses distrobox-enter to inspect managed export sources.  To keep
# this global verifier read-only, only aggregate it when all managed containers
# are already running; otherwise tell the operator to run wsbox check separately.
wsbox_all_running=true
wsbox_box_count=0
wsbox_manifest="$HOME/.local/share/workstation/distrobox/containers.ini"
if [[ -r "$wsbox_manifest" ]] && have podman; then
    while IFS= read -r box; do
        [[ -n "$box" ]] || continue
        ((wsbox_box_count++))
        state="$(podman inspect -f '{{.State.Running}}' "$box" 2>/dev/null || true)"
        [[ "$state" == "true" ]] || wsbox_all_running=false
    done < <(sed -nE 's/^\[([^]]+)\]$/\1/p' "$wsbox_manifest")
else
    wsbox_all_running=false
fi

if (( wsbox_box_count == 0 )); then
    fail "Distrobox manifest contains no managed containers"
elif [[ "$wsbox_all_running" == true ]] && have wsbox; then
    wsbox_out="$(wsbox check 2>&1)"
    wsbox_rc=$?

    if (( wsbox_rc == 0 )); then
        pass "wsbox check: no managed failures"
    else
        fail "wsbox check reported managed failures"
    fi

    printf '%s\n' "$wsbox_out" | sed 's/^/        /'
else
    info "wsbox check skipped to preserve READ-ONLY mode because not all managed containers are already running"
    info "run separately when desired: wsbox check"
fi

section "5.4 Windows programs (docs/plans/windows-gaming.md)"

boxes_ini="$HOME/.local/share/workstation/distrobox/boxes.ini"
apps_ini="$HOME/.local/share/workstation/windows/apps.ini"
# The ini files and launchers are home-manager files (section 4).
win_boxes="$(awk '/^\[/ { box = substr($0, 2, length($0) - 2) } /^profile=/ { print box }' "$boxes_ini" 2>/dev/null)"
if [[ -n "$win_boxes" ]]; then
    pass "Windows boxes: $(echo $win_boxes)"
else
    fail "no Windows box in boxes.ini (distrobox/distrobox.nix)"
fi

default_box="$(sed -nE 's/^default_box=//p' "$apps_ini" 2>/dev/null)"
if [[ -n "$default_box" ]] && grep -qxF "$default_box" <<<"$win_boxes"; then
    pass "wswin default box is a Windows box: $default_box"
else
    fail "wswin default box is not a Windows box: ${default_box:-<none>}"
fi

while IFS= read -r app; do
    [[ -n "$app" && "$app" != wswin ]] || continue
    app_box="$(awk -v s="[$app]" '$0 == s { i = 1; next } i && /^\[/ { exit } i && /^box=/ { sub(/^box=/, ""); print; exit }' "$apps_ini")"
    if grep -qxF "$app_box" <<<"$win_boxes"; then
        pass "app $app: box $app_box is a Windows box"
    else
        fail "app $app: box ${app_box:-<none>} is not a Windows box"
    fi
done < <(sed -nE 's/^\[([^]]+)\]$/\1/p' "$apps_ini" 2>/dev/null)

if have xdg-mime; then
    exe_default="$(xdg-mime query default application/vnd.microsoft.portable-executable 2>/dev/null)"
    if [[ "$exe_default" == ws-win-exe.desktop ]]; then
        pass ".exe opens with ws-win-exe.desktop (wine-wayland, standard prefix)"
    else
        warn ".exe opens with ${exe_default:-nothing}, not ws-win-exe.desktop (ws switch)"
    fi
fi

steam_desktop="flatpak/desktop/com.valvesoftware.Steam.desktop"
if grep -q '^Exec=ws-gpu run ' "$repo/$steam_desktop" 2>/dev/null; then
    pass "Steam launcher goes through ws-gpu (AMD when present)"
else
    fail "$steam_desktop does not start Steam through ws-gpu run"
fi

dangling_menu=""
for link in "$HOME"/.local/share/applications/wswin-*.desktop; do
    [[ -L "$link" && ! -e "$link" ]] && dangling_menu+=" $(basename "$link")"
done
if [[ -n "$dangling_menu" ]]; then
    warn "wswin menu links to missing prefixes:$dangling_menu (wswin menu sync)"
else
    pass "wswin menu links resolve"
fi

info "GPU for Proton/Steam: $("$repo/bin/ws-gpu" status 2>/dev/null || echo unknown)"

section "6. Script / config syntax"

bash_bad=false
while IFS= read -r -d '' path; do
    full="$repo/$path"
    [[ -f "$full" ]] || continue
    if head -n1 "$full" 2>/dev/null | grep -Eq '^#!.*\b(bash|sh)([[:space:]]|$)'; then
        if bash -n "$full" 2>/dev/null; then
            pass "bash syntax: $path"
        else
            bash_bad=true
            fail "bash syntax error: $path"
        fi
    fi
done < <(git -C "$repo" ls-files -z)
[[ "$bash_bad" == false ]] || true

if have fish; then
    fish_bad=false
    while IFS= read -r -d '' path; do
        [[ "$path" == *.fish ]] || continue
        if fish -n "$repo/$path" >/dev/null 2>&1; then
            pass "fish syntax: $path"
        else
            fish_bad=true
            fail "fish syntax error: $path"
        fi
    done < <(git -C "$repo" ls-files -z)
else
    warn "fish not installed; Fish syntax checks skipped"
fi

json_bad=false
while IFS= read -r -d '' path; do
    [[ "$path" == *.json ]] || continue
    if python3 -m json.tool "$repo/$path" >/dev/null 2>&1; then
        pass "JSON syntax: $path"
    else
        json_bad=true
        fail "JSON syntax error: $path"
    fi
done < <(git -C "$repo" ls-files -z)

while IFS= read -r -d '' path; do
    head -n1 "$repo/$path" 2>/dev/null | grep -Eq '^#!.*python' || continue
    py_out="$(mktemp)"
    if python3 -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' \
        "$repo/$path" "$py_out" >/dev/null 2>&1; then
        pass "Python syntax: $path"
    else
        fail "Python syntax error: $path"
    fi
    rm -f -- "$py_out"
done < <(git -C "$repo" ls-files -z)

if have udevadm; then
    while IFS= read -r -d '' path; do
        [[ "$path" == *.rules ]] || continue
        if udevadm verify --resolve-names=never "$repo/$path" >/dev/null 2>&1; then
            pass "udev syntax: $path"
        else
            fail "udev syntax error: $path"
        fi
    done < <(git -C "$repo" ls-files -z)
fi

if have shellcheck; then
    shellcheck_files=()
    while IFS= read -r -d '' path; do
        full="$repo/$path"
        [[ -f "$full" ]] || continue
        if head -n1 "$full" 2>/dev/null | grep -Eq '^#!.*\b(bash|sh)([[:space:]]|$)'; then
            shellcheck_files+=("$full")
        fi
    done < <(git -C "$repo" ls-files -z)
    if ((${#shellcheck_files[@]})); then
        if shellcheck -S warning "${shellcheck_files[@]}" >/tmp/ws-verify-shellcheck.$$ 2>&1; then
            pass "shellcheck -S warning"
        else
            warn "shellcheck reported issues:"
            sed 's/^/        /' /tmp/ws-verify-shellcheck.$$
        fi
        rm -f /tmp/ws-verify-shellcheck.$$
    fi
else
    info "shellcheck not installed; optional lint skipped"
fi

section "7. Runtime links / xremap"

if have xremap; then
    pass "xremap binary: $(command -v xremap)"
    info "xremap version: $(xremap --version 2>/dev/null || echo unknown)"
else
    fail "xremap binary missing"
fi

# ~/.local/bin/xremap: nix/pkgs/xremap.nix, pinned by hash (section 4).
xremap_real="$(readlink -f "$HOME/.local/bin/xremap" 2>/dev/null || true)"

id -nG | tr ' ' '\n' | grep -Fxq input \
    && pass "user belongs to input group" \
    || fail "user not in input group"

[[ -e /dev/uinput && -w /dev/uinput ]] \
    && pass "/dev/uinput exists and is writable" \
    || fail "/dev/uinput missing/not writable"

systemctl --user is-active --quiet xremap.service 2>/dev/null \
    && pass "xremap.service active" \
    || fail "xremap.service not active"

# keyboard/xremap.nix: home-manager owns the unit and its wants link;
# `ws-keyboard restore` switches xremap off with a ConditionPathExists flag.
[[ -L "$HOME/.config/systemd/user/graphical-session.target.wants/xremap.service" ]] \
    && pass "xremap.service wanted by graphical-session.target" \
    || fail "xremap.service wants link missing; run ws switch"
[[ -e "$HOME/.local/state/workstation/keyboard/xremap.disabled" ]] \
    && warn "xremap switched off by ws-keyboard restore (ws-keyboard apply turns it on)" \
    || pass "xremap not switched off by ws-keyboard restore"
[[ -s "$HOME/.local/state/workstation/keyboard/gsettings-backup.tsv" ]] \
    && pass "original GNOME shortcuts saved for ws-keyboard restore" \
    || warn "no ~/.local/state/workstation/keyboard/gsettings-backup.tsv; ws-keyboard restore has nothing to restore"
[[ -n "$xremap_env_bin" && "$xremap_env_bin" == "$xremap_real" ]] \
    && pass "xremap.service runs the same binary as ~/.local/bin/xremap" \
    || fail "xremap.service XREMAP_BIN ${xremap_env_bin:-unset} differs from ~/.local/bin/xremap"

# Links of bin/ into ~/.local/bin: section 4. ws-caps-led is not linked
# (binExcluded in nix/home/links.nix); the input-source extension runs it
# from the checkout.
if [[ -x "$repo/bin/ws-caps-led" ]]; then
    pass "ws-caps-led is an internal executable helper (PATH symlink not required)"
else
    fail "internal Caps LED helper missing/not executable: bin/ws-caps-led"
fi

if have busctl && busctl --user call \
    org.gnome.Shell \
    /com/k0kubun/Xremap \
    com.k0kubun.Xremap \
    WMClasses >/dev/null 2>&1; then
    pass "xremap GNOME Wayland bridge responds"
else
    fail "xremap GNOME Wayland bridge unavailable"
fi

contains_literal "$repo/bin/ws-xremap" \
    'Dynamic Function Row Virtual Input Device' \
    "xremap excludes the Dynamic Function Row virtual keyboard (loop guard)"
contains_literal "$repo/bin/ws-xremap" \
    '--output-device-name workstation-xremap' \
    "xremap output device has stable name"

virtual_found=false
for input_name in /sys/class/input/event*/device/name /sys/class/input/input*/name; do
    [[ -r "$input_name" ]] || continue
    if grep -Fxq 'workstation-xremap' "$input_name" 2>/dev/null; then
        virtual_found=true
        break
    fi
done
[[ "$virtual_found" == true ]] \
    && pass "virtual input device workstation-xremap present" \
    || warn "virtual input device workstation-xremap not found in /sys/class/input"

