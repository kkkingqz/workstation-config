[[ -r "$input_ext" ]] && {
    contains "$input_ext" 'Cycle\(direction\)' "Input Source extension has deterministic Cycle()"
    contains "$input_ext" 'UA/unknown -> EN' "Caps semantics include UA -> EN"
    contains_literal "$input_ext" "'locked-changed'" "v25.3 uses ScreenShield locked-changed"
    contains "$input_ext" '_isUnlockDialog\(\)' "v25.3 unlock-dialog policy present"
    contains "$input_ext" '_onCurrentSourceChanged\(\)' "v25.3 re-enforces EN after input-source reload"
    contains "$input_ext" '_syncLockScreenEnglish\(\)' "lock-screen EN enforcement hook present"
    contains "$input_ext" "this\._activate\('en'\)" "lock-screen hook activates EN"

    if grep -Fq -- "'notify::locked'" "$input_ext"; then
        fail "obsolete notify::locked remains in Input Source extension"
    else
        pass "obsolete notify::locked is absent"
    fi

    if python3 - "$input_ext" >/dev/null 2>&1 <<'PY'
import re, sys
s=open(sys.argv[1], encoding='utf-8').read()
m=re.search(r'_syncLockScreenEnglish\(\) \{(.*?)\n    \}', s, re.S)
if not m:
    raise SystemExit(1)
raise SystemExit(1 if 'caps-binary-state' in m.group(1) else 0)
PY
    then
        pass "lock-screen EN does not overwrite remembered Caps EN/RU state"
    else
        fail "lock-screen hook still modifies caps-binary-state"
    fi
}


section "10.1 GNOME extension policy"

required_gnome_extensions=(
    ding@rastersoft.com
    snapd-prompting@canonical.com
    snapd-search-provider@canonical.com
    tiling-assistant@ubuntu.com
    ubuntu-appindicators@ubuntu.com
    ubuntu-dock@ubuntu.com
    web-search-provider@ubuntu.com
    window-control@carlo9890.github.io
    window-monitor-pro@muhammed.hussien2030.gmail.com
    workstation-input-source@local
    workstation-smart-popup@local
    workstation-dock-spring@local
    xremap@k0kubun.com
)

if have gnome-extensions; then
    enabled_gnome_extensions="$(gnome-extensions list --enabled 2>/dev/null || true)"
    installed_gnome_extensions="$(gnome-extensions list 2>/dev/null || true)"

    for uuid in "${required_gnome_extensions[@]}"; do
        if grep -Fxq "$uuid" <<<"$enabled_gnome_extensions"; then
            pass "required GNOME extension enabled: $uuid"
        else
            fail "required GNOME extension missing/disabled: $uuid"
        fi
    done

    extra_extensions=()
    while IFS= read -r uuid; do
        [[ -n "$uuid" ]] || continue
        known=false
        for required_uuid in "${required_gnome_extensions[@]}"; do
            if [[ "$uuid" == "$required_uuid" ]]; then
                known=true
                break
            fi
        done
        [[ "$known" == true ]] || extra_extensions+=("$uuid")
    done <<<"$enabled_gnome_extensions"

    if ((${#extra_extensions[@]})); then
        warn "additional enabled GNOME extension(s): ${extra_extensions[*]}"
    else
        pass "enabled GNOME extension set matches policy"
    fi
else
    fail "gnome-extensions binary missing; extension policy cannot be checked"
fi


dock_spring="$repo/gnome/extensions/workstation-dock-spring@local/extension.js"
if [[ -r "$dock_spring" ]]; then
    contains_literal "$dock_spring" 'const HOVER_DELAY_MS = 1300;' \
        "Dock Spring delay frozen at 1300 ms"
    contains_literal "$dock_spring" 'running-app-only' \
        "Dock Spring running-app-only policy present"

    if grep -Eq '(^|[^A-Za-z0-9_])app\.activate\(' "$dock_spring" \
       || grep -Fq '_watchLaunchedApp' "$dock_spring"; then
        fail "Dock Spring still contains launch-on-hover logic"
    else
        pass "Dock Spring never launches a closed application on hover"
    fi
fi

