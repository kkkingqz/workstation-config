#!/usr/bin/env bash
set -u
set -o pipefail

# Full read-only audit for the workstation-config repository and the currently
# installed GNOME/Wayland macOS-style keyboard/workstation layer.
#
# Nothing is deleted, modified, staged, committed, enabled or restarted.
# Exit codes:
#   0 = no FAIL (warnings allowed)
#   1 = one or more FAIL
#   2 = warnings in --strict mode, but no FAIL

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"
strict=false

usage() {
    cat <<'USAGE'
Usage:
  ws-workstation-verify-v4.sh [--strict] [--repo PATH]
  ws-workstation-verify-v4.sh [PATH]          # compatibility shorthand

Options:
  --strict       WARN also makes the final result non-zero (exit 2)
  --repo PATH    repository to inspect
  -h, --help     show this help

The script is read-only. It does not run git add/commit, does not delete files,
and does not change GNOME/systemd settings.
USAGE
}

while (($#)); do
    case "$1" in
        --strict)
            strict=true
            shift
            ;;
        --repo)
            [[ $# -ge 2 ]] || { echo "--repo requires PATH" >&2; exit 64; }
            repo="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 64
            ;;
        *)
            repo="$1"
            shift
            ;;
    esac
done

repo="${repo%/}"

pass_n=0
warn_n=0
fail_n=0
info_n=0
cleanup_n=0

declare -a cleanup_items=()
declare -a git_add_candidates=()
declare -a git_remove_candidates=()

pass() { ((pass_n++)); printf '  PASS  %s\n' "$*"; }
warn() { ((warn_n++)); printf '  WARN  %s\n' "$*"; }
fail() { ((fail_n++)); printf '  FAIL  %s\n' "$*"; }
info() { ((info_n++)); printf '  INFO  %s\n' "$*"; }
declare -A cleanup_seen=()

cleanup() {
    local item="$*"
    if [[ -n "${cleanup_seen[$item]:-}" ]]; then
        return
    fi
    cleanup_seen["$item"]=1
    ((cleanup_n++))
    cleanup_items+=("$item")
    printf '  CLEAN %s\n' "$item"
}

section() {
    echo
    echo "$1"
    printf '%s\n' '------------------------------------------------------------------------'
}

have() { command -v "$1" >/dev/null 2>&1; }

q() { printf '%q' "$1"; }

contains() {
    local file="$1" regex="$2" label="$3"
    if [[ -r "$file" ]] && grep -Eq -- "$regex" "$file"; then
        pass "$label"
    else
        fail "$label"
    fi
}

contains_literal() {
    local file="$1" literal="$2" label="$3"
    if [[ -r "$file" ]] && grep -Fq -- "$literal" "$file"; then
        pass "$label"
    else
        fail "$label"
    fi
}

is_tracked() {
    git -C "$repo" ls-files --error-unmatch -- "$1" >/dev/null 2>&1
}

tracked() {
    local path="$1" label="${2:-$1}"
    if is_tracked "$path"; then
        pass "tracked: $label"
    elif [[ -e "$repo/$path" || -L "$repo/$path" ]]; then
        warn "exists locally but is NOT tracked: $label"
        git_add_candidates+=("$path")
    else
        fail "missing from repo: $label"
    fi
}

check_exec_tracked() {
    local path="$1"
    if [[ -e "$repo/$path" ]]; then
        [[ -x "$repo/$path" ]] \
            && pass "executable bit present: $path" \
            || fail "not executable: $path"
    fi
    if is_tracked "$path"; then
        local mode
        mode="$(git -C "$repo" ls-files -s -- "$path" | awk 'NR==1{print $1}')"
        [[ "$mode" == "100755" ]] \
            && pass "Git executable mode 100755: $path" \
            || fail "Git mode for $path is ${mode:-unknown}, expected 100755"
    fi
}

check_symlink_target() {
    local link="$1" expected="$2" label="$3"
    if [[ -L "$link" ]]; then
        local got exp
        got="$(readlink -f -- "$link" 2>/dev/null || true)"
        exp="$(readlink -f -- "$expected" 2>/dev/null || true)"
        [[ -n "$got" && -n "$exp" && "$got" == "$exp" ]] \
            && pass "$label" \
            || fail "$label — got $(q "$got"), expected $(q "$exp")"
    elif [[ -e "$link" ]]; then
        fail "$label — path exists but is not a symlink"
    else
        fail "$label — missing"
    fi
}

gget() {
    gsettings get "$1" "$2" 2>/dev/null || true
}

gcontains() {
    local schema="$1" key="$2" needle="$3" label="$4"
    local value
    value="$(gget "$schema" "$key")"
    if [[ "$value" == *"$needle"* ]]; then
        pass "$label"
    else
        fail "$label — got: ${value:-MISSING}"
    fi
}

extension_active() {
    local uuid="$1" label="$2" out
    if ! have gnome-extensions; then
        fail "gnome-extensions binary missing; cannot check $label"
        return
    fi
    out="$(gnome-extensions info "$uuid" 2>/dev/null || true)"
    if grep -Eq 'State:[[:space:]]+ACTIVE|Enabled:[[:space:]]+Yes' <<<"$out"; then
        pass "$label ($uuid)"
    else
        fail "$label ($uuid) not active"
    fi
}

locale1_prop() {
    busctl get-property \
        org.freedesktop.locale1 \
        /org/freedesktop/locale1 \
        org.freedesktop.locale1 \
        "$1" 2>/dev/null \
      | sed -E 's/^s "(.*)"$/\1/'
}

check_runtime_helper() {
    local name="$1"
    local source="$repo/bin/$name"
    local runtime="$HOME/.local/bin/$name"

    tracked "bin/$name" "bin/$name"
    [[ -e "$source" ]] && check_exec_tracked "bin/$name"

    if have "$name"; then
        pass "runtime helper resolves: $name -> $(command -v "$name")"
    else
        fail "runtime helper missing from PATH: $name"
    fi

    if [[ -e "$source" ]]; then
        check_symlink_target "$runtime" "$source" "~/.local/bin/$name points into repo"
    fi
}

compare_file() {
    local source="$1" runtime="$2" label="$3"
    if [[ ! -r "$source" ]]; then
        fail "$label — repo source missing: $source"
    elif [[ ! -r "$runtime" ]]; then
        fail "$label — runtime file missing: $runtime"
    elif cmp -s -- "$source" "$runtime"; then
        pass "$label"
    else
        warn "$label — runtime differs from repo source"
    fi
}

print_cmd_array() {
    local prefix="$1"; shift
    printf '  %s' "$prefix"
    local x
    for x in "$@"; do
        printf ' %q' "$x"
    done
    printf '\n'
}

echo "Workstation full verification v4"
echo "Repo: $repo"
echo "Time: $(date --iso-8601=seconds 2>/dev/null || date)"
echo "Mode: READ-ONLY"

section "1. Host / session"

model="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
[[ "$model" == "MacBookPro16,1" ]] \
    && pass "hardware: $model" \
    || warn "hardware: ${model:-unknown} (expected MacBookPro16,1 for this workstation)"

desktop="${XDG_CURRENT_DESKTOP:-unknown}"
[[ "$desktop" == *GNOME* ]] && pass "desktop: $desktop" || fail "desktop is not GNOME: $desktop"

session="${XDG_SESSION_TYPE:-unknown}"
[[ "$session" == "wayland" ]] && pass "session: Wayland" || warn "session: $session"

if have gnome-shell; then
    gv="$(gnome-shell --version 2>/dev/null || true)"
    [[ -n "$gv" ]] && info "GNOME: $gv" || warn "unable to read GNOME Shell version"
else
    fail "gnome-shell binary missing"
fi

kernel="$(uname -r)"
[[ "$kernel" == *t2* ]] && pass "T2 kernel: $kernel" || warn "kernel is not T2-labelled: $kernel"

section "2. Repository identity / Git integrity"

if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    fail "not a Git repository: $repo"
    echo
    echo "RESULT: FAILED"
    exit 1
fi
pass "Git repository exists"

branch="$(git -C "$repo" branch --show-current 2>/dev/null || true)"
[[ "$branch" == "main" ]] && pass "branch: main" || warn "branch: ${branch:-detached}"

origin="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
[[ "$origin" == *"kkkingqz/workstation-config"* ]] \
    && pass "origin: $origin" \
    || warn "unexpected origin: ${origin:-none}"

head="$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)"
info "HEAD: ${head:-unknown}"

if git -C "$repo" diff --check >/dev/null 2>&1; then
    pass "git diff --check"
else
    fail "git diff --check found whitespace errors"
fi

if git -C "$repo" diff --cached --check >/dev/null 2>&1; then
    pass "git diff --cached --check"
else
    fail "git diff --cached --check found whitespace errors"
fi

if git -C "$repo" fsck --no-progress --full >/dev/null 2>&1; then
    pass "git fsck --full"
else
    fail "git fsck reports repository object errors"
fi

status_porcelain="$(git -C "$repo" status --porcelain=v1 --untracked-files=all 2>/dev/null || true)"
if [[ -z "$status_porcelain" ]]; then
    pass "working tree clean"
else
    warn "working tree has staged/modified/untracked files"
    printf '%s\n' "$status_porcelain" | sed 's/^/        /'
fi

upstream="$(git -C "$repo" rev-parse '@{u}' 2>/dev/null || true)"
if [[ -n "$upstream" ]]; then
    if [[ "$head" == "$upstream" ]]; then
        pass "HEAD matches local upstream-tracking ref"
    else
        local_counts="$(git -C "$repo" rev-list --left-right --count HEAD...@{u} 2>/dev/null || echo '? ?')"
        warn "HEAD differs from local upstream-tracking ref (HEAD...upstream = $local_counts)"
    fi
else
    warn "branch has no upstream-tracking ref"
fi

if [[ -n "$origin" && "$branch" == "main" ]] && have timeout; then
    remote_head="$(timeout 10 git -C "$repo" ls-remote --heads origin refs/heads/main 2>/dev/null | awk 'NR==1{print $1}')"
    if [[ -n "$remote_head" ]]; then
        info "origin/main live SHA: $remote_head"
        [[ "$remote_head" == "$head" ]] \
            && pass "local HEAD exactly matches live origin/main" \
            || warn "local HEAD does not exactly match live origin/main"
    else
        warn "could not query live origin/main (network/auth unavailable?)"
    fi
fi

section "3. Repository hygiene / junk detection"

weird_found=false
while IFS= read -r -d '' path; do
    bad=false
    reason=""

    if [[ "$path" == *$'\n'* || "$path" == *$'\r'* || "$path" == *$'\t'* ]]; then
        bad=true; reason="contains control whitespace"
    elif [[ "$path" =~ (^|/)[[:space:]] || "$path" =~ [[:space:]]$ ]]; then
        bad=true; reason="leading/trailing whitespace"
    elif [[ "$path" == *'\\'* ]]; then
        bad=true; reason="contains backslash"
    fi

    if [[ "$bad" == true ]]; then
        weird_found=true
        cleanup "tracked suspicious filename ($(q "$path")): $reason"
        git_remove_candidates+=("$path")
    fi
done < <(git -C "$repo" ls-files -z)
[[ "$weird_found" == false ]] && pass "no tracked filenames with control/trailing whitespace/backslashes"

zero_found=false
while IFS= read -r -d '' path; do
    full="$repo/$path"
    if [[ -f "$full" && ! -s "$full" ]]; then
        zero_found=true
        cleanup "tracked zero-byte file: $(q "$path")"
        git_remove_candidates+=("$path")
    fi
done < <(git -C "$repo" ls-files -z)
[[ "$zero_found" == false ]] && pass "no tracked zero-byte regular files"

junk_found=false
while IFS= read -r -d '' path; do
    base="${path##*/}"
    case "$base" in
        *~|*.bak|*.backup|*.orig|*.rej|*.swp|*.swo|*.tmp|*.temp|.DS_Store|Thumbs.db|*.pyc)
            junk_found=true
            cleanup "tracked backup/editor/temp candidate: $(q "$path")"
            git_remove_candidates+=("$path")
            ;;
    esac
    case "$path" in
        fix-keyboard-layer-v*.sh|*/fix-keyboard-layer-v*.sh|rollback-keyboard-layer-v*.sh|*/rollback-keyboard-layer-v*.sh)
            junk_found=true
            cleanup "tracked one-shot migration/fix script candidate: $(q "$path")"
            ;;
    esac
done < <(git -C "$repo" ls-files -z)
[[ "$junk_found" == false ]] && pass "no obvious tracked editor/backup/one-shot junk"

runtime_tracked=false
for p in state runtime config/micro-help/buffers; do
    if git -C "$repo" ls-files -- "$p" | grep -q .; then
        runtime_tracked=true
        fail "generated/runtime path is tracked: $p"
    fi
done
[[ "$runtime_tracked" == false ]] && pass "runtime/generated directories are not tracked"

for ignored in state/probe runtime/probe config/micro-help/buffers/probe gnome/extensions/workstation-input-source@local/schemas/gschemas.compiled gnome/extensions/workstation-smart-popup@local/schemas/gschemas.compiled; do
    if git -C "$repo" check-ignore -q -- "$ignored"; then
        pass ".gitignore covers: $ignored"
    else
        warn ".gitignore does not cover expected runtime path: $ignored"
    fi
done

broken_link=false
while IFS= read -r -d '' p; do
    if [[ -L "$p" && ! -e "$p" ]]; then
        broken_link=true
        fail "broken symlink in repo tree: $(q "${p#$repo/}") -> $(q "$(readlink "$p")")"
    fi
done < <(find "$repo" -path "$repo/.git" -prune -o -type l -print0 2>/dev/null)
[[ "$broken_link" == false ]] && pass "no broken symlinks inside repository tree"

large_found=false
while IFS= read -r -d '' path; do
    full="$repo/$path"
    [[ -f "$full" ]] || continue
    size="$(stat -c %s "$full" 2>/dev/null || echo 0)"
    if (( size > 5 * 1024 * 1024 )); then
        large_found=true
        warn "tracked file >5 MiB: $path ($size bytes)"
    fi
done < <(git -C "$repo" ls-files -z)
[[ "$large_found" == false ]] && pass "no tracked files larger than 5 MiB"

if git -C "$repo" grep -nEI -- \
    '-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{20,}' \
    -- . ':(exclude)docs/*.md' >/tmp/ws-verify-secret.$$ 2>/dev/null; then
    warn "possible secret/private-key marker in tracked files (inspect manually):"
    sed 's/^/        /' /tmp/ws-verify-secret.$$
else
    pass "no obvious private-key/GitHub/AWS secret markers in tracked non-doc files"
fi
rm -f /tmp/ws-verify-secret.$$

expected_input_helper="$repo/bin/ws-input-source"
input_helper_paths="$(grep -oE '"/[^"]*/ws-input-source"' "$repo/config/keyboard/xremap.yml" 2>/dev/null | tr -d '"' | sort -u || true)"
if [[ -z "$input_helper_paths" ]]; then
    fail "xremap contains no absolute ws-input-source launch path"
else
    bad_input_path=false
    while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        if [[ "$p" != "$expected_input_helper" ]]; then
            bad_input_path=true
            warn "xremap ws-input-source path mismatch: $(q "$p"), expected $(q "$expected_input_helper")"
        fi
    done <<<"$input_helper_paths"
    [[ "$bad_input_path" == false ]] && pass "xremap absolute ws-input-source path matches current repo"
fi

expected_led_helper="$repo/bin/ws-caps-led"
led_helper_literal="$(sed -n 's/^const LED_HELPER = "\([^"]*\)";$/\1/p' "$repo/gnome/extensions/workstation-input-source@local/extension.js" | head -n1)"
if [[ "$led_helper_literal" == "$expected_led_helper" ]]; then
    pass "Input Source LED helper absolute path matches current repo"
else
    fail "Input Source LED helper path mismatch: ${led_helper_literal:-MISSING}; expected $expected_led_helper"
fi

current_home_prefix="${HOME%/}/"
other_hardcoded_home="$(git -C "$repo" grep -nF "$current_home_prefix" -- \
    ':!docs/**' \
    ':!man/**' \
    ':!config/keyboard/xremap.yml' \
    ':!bin/ws-workstation-verify' \
    ':!gnome/extensions/workstation-input-source@local/extension.js' \
    2>/dev/null || true)"
if [[ -n "$other_hardcoded_home" ]]; then
    warn "unexpected hard-coded current HOME paths found outside validated helper locations:"
    printf '%s\n' "$other_hardcoded_home" | sed 's/^/        /'
else
    pass "no unexpected hard-coded current HOME paths outside validated helper locations"
fi

conflict_hits="$(git -C "$repo" grep -nE '^(<<<<<<<|=======|>>>>>>>)' -- . 2>/dev/null || true)"
[[ -z "$conflict_hits" ]] \
    && pass "no merge-conflict markers in tracked files" \
    || { fail "merge-conflict markers found"; printf '%s\n' "$conflict_hits" | sed 's/^/        /'; }

crlf_found=false
while IFS= read -r -d '' path; do
    full="$repo/$path"
    [[ -f "$full" ]] || continue
    case "$path" in
        *.sh|*.fish|*.yml|*.yaml|*.toml|*.service|*.rules|*.md|*.ghostty|*.json)
            if LC_ALL=C grep -q $'\r$' "$full" 2>/dev/null; then
                crlf_found=true
                warn "CRLF line endings: $path"
            fi
            ;;
    esac
done < <(git -C "$repo" ls-files -z)
[[ "$crlf_found" == false ]] && pass "no CRLF in tracked config/script/docs files"

section "4. Required source-of-truth / reproducibility"

for path in \
    .gitignore \
    config/keyboard/settings.conf \
    config/keyboard/xremap.yml \
    config/ghostty/config.ghostty \
    config/ghostty/keybinds.ghostty \
    config/ghostty/shell-keys.ghostty \
    bin/ws-keyboard \
    bin/ws-keyboard-apply \
    bin/ws-keyboard-status \
    bin/ws-xremap \
    systemd/user/xremap.service \
    system/udev/99-workstation-uinput.rules \
    docs/keyboard.md \
    docs/touchbar.md
do
    tracked "$path" "$path"
done

for name in ws-keyboard ws-keyboard-apply ws-keyboard-status ws-xremap; do
    [[ -e "$repo/bin/$name" ]] && check_exec_tracked "bin/$name"
done

# These were added during the final macOS-style workstation work and must be
# source-controlled for a clean-clone rebuild to be complete.
for path in \
    bin/ws-window \
    bin/ws-nautilus-current \
    bin/ws-input-source \
    bin/ws-caps-led \
    bin/ws-tiling-apply \
    bin/ws-keyboard-install-extensions \
    bin/ws-keyboard-system-apply \
    bin/ws-workstation-verify \
    bin/ws-gnome \
    bin/ws-gnome-apply \
    bin/ws-gnome-status \
    bin/ws-gnome-test \
    config/fish/completions/ws-gnome-test.fish \
    config/gnome/settings.conf \
    config/fish/completions/ws-gnome.fish \
    docs/gnome.md \
    system/udev/90-touchbar-native.rules \
    system/modprobe/tb.conf \
    system/modprobe/touchbar-native.conf \
    system/usr/local/libexec/ws-touchbar-fn \
    system/systemd/system/ws-touchbar-fn.service \
    system/sleep.conf.d/80-deep-only.conf \
    system/udev/70-bcm4364-no-d3cold.rules \
    system/usr/local/sbin/broadcom-aspm-suspend-guard \
    system/usr/lib/systemd/system-sleep/80-broadcom-aspm \
    system/systemd/system/broadcom-aspm-restore.service \
    kernel/t2bce/nostate-fix.patch \
    kernel/t2bce/sources.conf \
    docs/suspend.md \
    gnome/extensions/workstation-smart-popup@local/metadata.json \
    gnome/extensions/workstation-smart-popup@local/extension.js \
    gnome/extensions/workstation-dock-spring@local/metadata.json \
    gnome/extensions/workstation-dock-spring@local/extension.js \
    gnome/extensions/workstation-smart-popup@local/schemas/org.gnome.shell.extensions.workstation-smart-popup.gschema.xml \
    gnome/extensions/workstation-input-source@local/metadata.json \
    gnome/extensions/workstation-input-source@local/extension.js \
    gnome/extensions/workstation-input-source@local/schemas/org.gnome.shell.extensions.workstation-input-source.gschema.xml
do
    tracked "$path" "$path"
done


# GNOME desktop helpers are part of the reproducible user runtime layer.
for name in ws-gnome ws-gnome-apply ws-gnome-status ws-gnome-test; do
    check_runtime_helper "$name"
done

tracked "config/fish/completions/ws-gnome.fish" "GNOME Fish completion"
tracked "docs/plans/gnome.md" "GNOME implementation plan"

# Suspend / T2 power layer helper.
check_runtime_helper ws-suspend

# Functional baseline / regression gate of the Nix migration.
check_runtime_helper ws-baseline
check_runtime_helper ws
for path in system/usr/local/sbin/broadcom-aspm-suspend-guard system/usr/lib/systemd/system-sleep/80-broadcom-aspm; do
    [[ -e "$repo/$path" ]] && check_exec_tracked "$path"
done

section "5. Apply reproducibility"

apply="$repo/bin/ws-keyboard-apply"
contains_literal "$apply" 'bin/ws-window' "apply installs ws-window runtime link"
contains_literal "$apply" 'bin/ws-nautilus-current' "apply installs ws-nautilus-current runtime link"
contains_literal "$apply" 'bin/ws-input-source' "apply installs ws-input-source runtime link"
contains_literal "$apply" 'bin/ws-tiling-apply' "apply installs ws-tiling-apply runtime link"
contains_literal "$apply" 'ws-keyboard-install-extensions' "apply installs/reuses local GNOME extension sources"
contains_literal "$apply" 'ws-tiling-apply' "apply reapplies Tiling Assistant private bindings"
[[ -x "$repo/bin/ws-keyboard-system-apply" ]] \
    && pass "system-level keyboard/uinput/Touch Bar apply helper is executable" \
    || fail "bin/ws-keyboard-system-apply missing/not executable"
contains_literal "$repo/bin/ws-keyboard-system-apply" '"$repo/bin/ws" system apply' \
    "ws-keyboard-system-apply delegates to ws system apply (one owner of system files)"
contains_literal "$repo/bin/ws-suspend" '"$repo/bin/ws" system apply' \
    "ws-suspend apply delegates to ws system apply (one owner of system files)"
[[ -e "$repo/system/usr/local/libexec/ws-touchbar-fn" ]] && check_exec_tracked "system/usr/local/libexec/ws-touchbar-fn"


section "5.1 GNOME managed appearance"

gnome_profile="$repo/config/gnome/settings.conf"
if [[ -r "$gnome_profile" ]]; then
    pass "GNOME managed profile present"
else
    fail "GNOME managed profile missing: config/gnome/settings.conf"
fi

if [[ -x "$repo/bin/ws-gnome-apply" ]]; then
    if WORKSTATION_CONFIG="$repo" "$repo/bin/ws-gnome-apply" --check --quiet >/dev/null 2>&1; then
        pass "GNOME managed appearance/Dock profile is in sync"
    else
        fail "GNOME managed appearance/Dock profile has drift or cannot be validated"
    fi
else
    fail "bin/ws-gnome-apply is missing or not executable"
fi

if [[ -r "$gnome_profile" ]]; then
    forbidden_gnome_profile="$(
        grep -nE \
          'org\.gnome\.desktop\.interface\|text-scaling-factor|org\.gnome\.mutter\|experimental-features|org\.gnome\.desktop\.input-sources|org\.gnome\.desktop\.wm\.keybindings|org\.gnome\.settings-daemon\.plugins\.media-keys|org\.gnome\.shell\|(enabled-extensions|disabled-extensions)|org\.gnome\.shell\.extensions\.tiling-assistant' \
          "$gnome_profile" 2>/dev/null || true
    )"
    if [[ -z "$forbidden_gnome_profile" ]]; then
        pass "GNOME profile does not overlap display/keyboard/extension ownership"
    else
        fail "GNOME profile contains forbidden cross-layer settings:"
        printf '%s\n' "$forbidden_gnome_profile" | sed 's/^/        /'
    fi
fi


section "5.2 Host Qt integration"

for pkg in qgnomeplatform-qt5 qgnomeplatform-qt6 qtwayland5 qt6-wayland; do
    if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null \
        | grep -qx 'install ok installed'; then
        pass "host Qt baseline package installed: $pkg"
    else
        fail "host Qt baseline package missing: $pkg"
    fi
done

qt_override_bad=false
for var in QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE QT_SCALE_FACTOR; do
    value="${!var:-}"
    if [[ -n "$value" ]]; then
        qt_override_bad=true
        fail "global Qt override should be unset: $var=$value"
    fi
done
[[ "$qt_override_bad" == false ]] \
    && pass "no global Qt platform/theme/scale overrides"


section "5.3 Managed Distrobox / Podman layer"

for path in \
    bin/wsbox \
    config/fish/completions/wsbox.fish \
    config/distrobox/containers.ini \
    config/distrobox/exports.ini \
    config/distrobox/host/modules-load.d/ntsync.conf \
    config/distrobox/arch/wsbox-host-ntsync/PKGBUILD \
    config/distrobox/arch/wsbox-host-ntsync/README.md \
    docs/plans/development.md
do
    tracked "$path" "$path"
done

[[ -e "$repo/bin/wsbox" ]] && check_exec_tracked "bin/wsbox"

if [[ -e "$repo/bin/wsbox" ]]; then
    check_symlink_target \
        "$HOME/.local/bin/wsbox" \
        "$repo/bin/wsbox" \
        "~/.local/bin/wsbox points into repo"
fi

if [[ -e "$repo/config/fish/completions/wsbox.fish" ]]; then
    check_symlink_target \
        "$HOME/.config/fish/completions/wsbox.fish" \
        "$repo/config/fish/completions/wsbox.fish" \
        "Fish wsbox completion points into repo"
fi

ntsync_source="$repo/config/distrobox/host/modules-load.d/ntsync.conf"
ntsync_runtime="/etc/modules-load.d/ntsync.conf"
compare_file "$ntsync_source" "$ntsync_runtime" \
    "host NTSync modules-load config matches repo source"

if lsmod 2>/dev/null | awk '$1 == "ntsync" { found=1 } END { exit !found }'; then
    pass "host ntsync module loaded"
else
    fail "host ntsync module not loaded"
fi

[[ -c /dev/ntsync ]] \
    && pass "/dev/ntsync character device present" \
    || fail "/dev/ntsync character device missing"

ntsync_pkgbuild="$repo/config/distrobox/arch/wsbox-host-ntsync/PKGBUILD"
if [[ -r "$ntsync_pkgbuild" ]]; then
    if bash -n "$ntsync_pkgbuild" >/dev/null 2>&1; then
        pass "bash syntax: config/distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    else
        fail "bash syntax error: config/distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    fi

    contains_literal \
        "$ntsync_pkgbuild" \
        'provides=("NTSYNC-MODULE")' \
        "Arch host-NTSync package provides NTSYNC-MODULE"
fi

if have podman && podman container exists arch >/dev/null 2>&1; then
    arch_running="$(podman inspect -f '{{.State.Running}}' arch 2>/dev/null || true)"
    if [[ "$arch_running" == "true" ]]; then
        if podman exec arch pacman -Q wsbox-host-ntsync >/dev/null 2>&1; then
            pass "arch: wsbox-host-ntsync installed"
        else
            fail "arch: wsbox-host-ntsync missing"
        fi

        ntsync_missing="$(
            podman exec arch pacman -T NTSYNC-MODULE 2>/dev/null || true
        )"
        [[ -z "$ntsync_missing" ]] \
            && pass "arch: NTSYNC-MODULE dependency satisfied" \
            || fail "arch: NTSYNC-MODULE dependency unsatisfied: $ntsync_missing"

        for pkg in linux mkinitcpio mkinitcpio-busybox; do
            if podman exec arch pacman -Q "$pkg" >/dev/null 2>&1; then
                fail "arch: container-local kernel/initramfs package should be absent: $pkg"
            else
                pass "arch: container-local package absent: $pkg"
            fi
        done

        podman exec arch test -c /dev/ntsync >/dev/null 2>&1 \
            && pass "arch: /dev/ntsync visible inside running container" \
            || fail "arch: /dev/ntsync not visible inside running container"
    else
        info "arch container is not running; skipped read-only in-container NTSync checks"
    fi
else
    info "arch container missing; wsbox layer check will report it when run"
fi

# wsbox check uses distrobox-enter to inspect managed export sources.  To keep
# this global verifier read-only, only aggregate it when all managed containers
# are already running; otherwise tell the operator to run wsbox check separately.
wsbox_all_running=true
wsbox_box_count=0
if [[ -r "$repo/config/distrobox/containers.ini" ]] && have podman; then
    while IFS= read -r box; do
        [[ -n "$box" ]] || continue
        ((wsbox_box_count++))
        state="$(podman inspect -f '{{.State.Running}}' "$box" 2>/dev/null || true)"
        [[ "$state" == "true" ]] || wsbox_all_running=false
    done < <(sed -nE 's/^\[([^]]+)\]$/\1/p' "$repo/config/distrobox/containers.ini")
else
    wsbox_all_running=false
fi

if (( wsbox_box_count == 0 )); then
    fail "Distrobox manifest contains no managed containers"
elif [[ "$wsbox_all_running" == true ]] && have wsbox; then
    wsbox_out="$(wsbox check 2>&1)"
    wsbox_rc=$?

    if (( wsbox_rc == 0 )); then
        pass "wsbox check: no managed failures"
    else
        fail "wsbox check reported managed failures"
    fi

    printf '%s\n' "$wsbox_out" | sed 's/^/        /'
else
    info "wsbox check skipped to preserve READ-ONLY mode because not all managed containers are already running"
    info "run separately when desired: wsbox check"
fi

section "6. Script / config syntax"

bash_bad=false
while IFS= read -r -d '' path; do
    full="$repo/$path"
    [[ -f "$full" ]] || continue
    if head -n1 "$full" 2>/dev/null | grep -Eq '^#!.*\b(bash|sh)([[:space:]]|$)'; then
        if bash -n "$full" 2>/dev/null; then
            pass "bash syntax: $path"
        else
            bash_bad=true
            fail "bash syntax error: $path"
        fi
    fi
done < <(git -C "$repo" ls-files -z)
[[ "$bash_bad" == false ]] || true

if have fish; then
    fish_bad=false
    while IFS= read -r -d '' path; do
        [[ "$path" == *.fish ]] || continue
        if fish -n "$repo/$path" >/dev/null 2>&1; then
            pass "fish syntax: $path"
        else
            fish_bad=true
            fail "fish syntax error: $path"
        fi
    done < <(git -C "$repo" ls-files -z)
else
    warn "fish not installed; Fish syntax checks skipped"
fi

json_bad=false
while IFS= read -r -d '' path; do
    [[ "$path" == *.json ]] || continue
    if python3 -m json.tool "$repo/$path" >/dev/null 2>&1; then
        pass "JSON syntax: $path"
    else
        json_bad=true
        fail "JSON syntax error: $path"
    fi
done < <(git -C "$repo" ls-files -z)

fn_helper="$repo/system/usr/local/libexec/ws-touchbar-fn"
if [[ -r "$fn_helper" ]]; then
    fn_pyc="$(mktemp)"
    if python3 -c 'import py_compile, sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)' \
        "$fn_helper" "$fn_pyc" >/dev/null 2>&1; then
        pass "Python syntax: system/usr/local/libexec/ws-touchbar-fn"
    else
        fail "Python syntax error: system/usr/local/libexec/ws-touchbar-fn"
    fi
    rm -f -- "$fn_pyc"
fi

if have udevadm && [[ -r "$repo/system/udev/90-touchbar-native.rules" ]]; then
    if udevadm verify --resolve-names=never "$repo/system/udev/90-touchbar-native.rules" >/dev/null 2>&1; then
        pass "udev syntax: system/udev/90-touchbar-native.rules"
    else
        fail "udev syntax error: system/udev/90-touchbar-native.rules"
    fi
fi

if have shellcheck; then
    shellcheck_files=()
    while IFS= read -r -d '' path; do
        full="$repo/$path"
        [[ -f "$full" ]] || continue
        if head -n1 "$full" 2>/dev/null | grep -Eq '^#!.*\b(bash|sh)([[:space:]]|$)'; then
            shellcheck_files+=("$full")
        fi
    done < <(git -C "$repo" ls-files -z)
    if ((${#shellcheck_files[@]})); then
        if shellcheck -S warning "${shellcheck_files[@]}" >/tmp/ws-verify-shellcheck.$$ 2>&1; then
            pass "shellcheck -S warning"
        else
            warn "shellcheck reported issues:"
            sed 's/^/        /' /tmp/ws-verify-shellcheck.$$
        fi
        rm -f /tmp/ws-verify-shellcheck.$$
    fi
else
    info "shellcheck not installed; optional lint skipped"
fi

section "7. Runtime links / xremap"

if have xremap; then
    pass "xremap binary: $(command -v xremap)"
    info "xremap version: $(xremap --version 2>/dev/null || echo unknown)"
else
    fail "xremap binary missing"
fi

# pkgs/xremap.nix: upstream xremap-linux-x86_64-gnome.zip v0.15.13 by hash;
# the binary must stay byte-identical to the pre-migration one.
xremap_sha256=3da5ec8a619a326f35a72e952abe84b14053732ff895bfefe7a043714fab227e
xremap_real="$(readlink -f "$HOME/.local/bin/xremap" 2>/dev/null || true)"
if [[ "$xremap_real" == /nix/store/*-xremap-gnome-*/bin/xremap ]]; then
    pass "~/.local/bin/xremap comes from Nix: ${xremap_real#/nix/store/}"
else
    warn "~/.local/bin/xremap is not the Nix package (${xremap_real:-missing})"
fi
[[ -n "$xremap_real" && "$(sha256sum "$xremap_real" 2>/dev/null | cut -d' ' -f1)" == "$xremap_sha256" ]] \
    && pass "xremap binary sha256 matches v0.15.13 gnome build" \
    || fail "xremap binary sha256 differs from the pinned v0.15.13 gnome build"

id -nG | tr ' ' '\n' | grep -Fxq input \
    && pass "user belongs to input group" \
    || fail "user not in input group"

[[ -e /dev/uinput && -w /dev/uinput ]] \
    && pass "/dev/uinput exists and is writable" \
    || fail "/dev/uinput missing/not writable"

systemctl --user is-active --quiet xremap.service 2>/dev/null \
    && pass "xremap.service active" \
    || fail "xremap.service not active"

systemctl --user is-enabled --quiet xremap.service 2>/dev/null \
    && pass "xremap.service enabled" \
    || warn "xremap.service not enabled"

check_symlink_target \
    "$HOME/.config/systemd/user/xremap.service" \
    "$repo/systemd/user/xremap.service" \
    "xremap user-service link points into repo"

for name in ws-keyboard ws-keyboard-apply ws-keyboard-status ws-xremap; do
    [[ -e "$repo/bin/$name" ]] && check_symlink_target \
        "$HOME/.local/bin/$name" "$repo/bin/$name" \
        "~/.local/bin/$name points into repo"
done

if [[ -e "$repo/bin/ws-workstation-verify" ]]; then
    check_symlink_target \
        "$HOME/.local/bin/ws-workstation-verify" \
        "$repo/bin/ws-workstation-verify" \
        "~/.local/bin/ws-workstation-verify points into repo"
fi

if [[ -e "$repo/bin/ws-keyboard-install-extensions" ]]; then
    check_symlink_target \
        "$HOME/.local/bin/ws-keyboard-install-extensions" \
        "$repo/bin/ws-keyboard-install-extensions" \
        "~/.local/bin/ws-keyboard-install-extensions points into repo"
fi

if [[ -e "$repo/bin/ws-keyboard-system-apply" ]]; then
    check_symlink_target \
        "$HOME/.local/bin/ws-keyboard-system-apply" \
        "$repo/bin/ws-keyboard-system-apply" \
        "~/.local/bin/ws-keyboard-system-apply points into repo"
