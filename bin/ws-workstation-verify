info "sources: $sources"
info "mru-sources: $mru_sources"

for code in us ru ua; do
    [[ "$sources" == *"'$code'"* ]] \
        && pass "input source configured: $code" \
        || fail "input source missing: $code"
    [[ "$mru_sources" == *"'$code'"* ]] \
        && pass "MRU source contains: $code" \
        || warn "MRU source missing: $code"
done

if have ws-input-source; then
    state_out="$(ws-input-source status 2>/dev/null || true)"
    [[ -n "$state_out" ]] \
        && pass "ws-input-source status works: $state_out" \
        || fail "ws-input-source status failed"
fi

if have busctl; then
    sys_layout="$(locale1_prop X11Layout)"
    [[ "$sys_layout" == "us" ]] \
        && pass "GDM/login system X11 layout forced to US" \
        || fail "GDM/login X11 layout is '${sys_layout:-unknown}', expected us"
fi

meta="$repo/gnome/extensions/workstation-input-source@local/metadata.json"
if [[ -r "$meta" ]] && python3 - "$meta" >/dev/null 2>&1 <<'PY'
import json, sys
with open(sys.argv[1], encoding='utf-8') as f:
    d=json.load(f)
m=d.get("session-modes", [])
raise SystemExit(0 if "user" in m and "unlock-dialog" in m else 1)
PY
then
    pass "Input Source extension enabled for unlock-dialog"
elif [[ -r "$meta" ]]; then
    fail "Input Source extension metadata lacks user/unlock-dialog session modes"
fi

section "13. Ghostty frozen keyboard layer"

ghost="$repo/terminal/ghostty/keybinds.ghostty"
for literal in \
    'keybind = super+KeyC=copy_to_clipboard' \
    'keybind = super+KeyV=paste_from_clipboard' \
    'keybind = super+KeyA=select_all' \
    'keybind = super+KeyF=start_search' \
    'keybind = super+KeyT=new_tab' \
    'keybind = super+KeyN=new_window' \
    'keybind = super+KeyW=close_surface' \
    'keybind = all:super+KeyQ=close_window' \
    'keybind = super+comma=open_config' \
    'keybind = super+equal=increase_font_size:1' \
    'keybind = super+minus=decrease_font_size:1' \
    'keybind = super+Digit0=reset_font_size'
do
    if grep -Fqx -- "$literal" "$ghost" 2>/dev/null; then
        pass "Ghostty frozen: $literal"
    else
        fail "Ghostty frozen binding missing: $literal"
    fi
done

section "14. Touch Bar native mode / udev"

tb_usb=""
for dev in /sys/bus/usb/devices/*; do
    if [[ "$(cat "$dev/idVendor" 2>/dev/null):$(cat "$dev/idProduct" 2>/dev/null)" == "05ac:8302" ]]; then
        tb_usb="$dev"
        break
    fi
done
if [[ -n "$tb_usb" ]]; then
    tb_cfg="$(cat "$tb_usb/bConfigurationValue" 2>/dev/null || true)"
    [[ "$tb_cfg" == "1" ]] \
        && pass "Touch Bar USB configuration 1 (native keyboard mode)" \
        || fail "Touch Bar USB configuration is '${tb_cfg:-0}', expected 1"
else
    fail "Touch Bar USB device 05ac:8302 not found"
fi

[[ -d /sys/module/appletbdrm ]] \
    && fail "appletbdrm is loaded (Touch Bar display mode)" \
    || pass "appletbdrm not loaded"

tb_mode_node=""
for node in /sys/bus/hid/drivers/hid-appletb-kbd/*/mode; do
    [[ -r "$node" ]] && { tb_mode_node="$node"; break; }
done
if [[ -n "$tb_mode_node" ]]; then
    tb_mode="$(cat "$tb_mode_node" 2>/dev/null || true)"
    [[ "$tb_mode" == "1" ]] \
        && pass "hid-appletb-kbd bound, mode 1 (F1..F12)" \
        || warn "hid-appletb-kbd mode is '$tb_mode', expected 1 unless Fn is held"
else
    fail "hid-appletb-kbd is not bound to the Touch Bar"
fi

if have dpkg-query && dpkg-query -W -f='${Status}' tiny-dfr 2>/dev/null | grep -q 'install ok installed'; then
    fail "tiny-dfr is installed (it switches the Touch Bar to display mode)"
else
    pass "tiny-dfr not installed"
fi

# Installed files and unit states: ws system check (system/*.nix manifest).
systemctl is-active --quiet ws-touchbar-fn.service 2>/dev/null \
    && pass "ws-touchbar-fn.service active" \
    || fail "ws-touchbar-fn.service not active"

if [[ -e /etc/tiny-dfr/config.toml ]]; then
    warn "obsolete runtime /etc/tiny-dfr/config.toml still exists (ws-keyboard-system-apply removes it)"
else
    pass "obsolete /etc/tiny-dfr/config.toml absent"
fi

if [[ -e "$repo/system/files/udev/70-workstation-uinput.rules" ]]; then
    fail "obsolete repo udev rule still exists: system/files/udev/70-workstation-uinput.rules"
else
    pass "obsolete repo 70-workstation-uinput.rules absent"
fi

if [[ -e /etc/udev/rules.d/70-workstation-uinput.rules ]]; then
    warn "obsolete runtime /etc/udev/rules.d/70-workstation-uinput.rules still exists"
else
    pass "obsolete runtime 70-workstation-uinput.rules absent"
fi

section "14.1 Suspend / T2 power"

grep -Fq '[deep]' /sys/power/mem_sleep 2>/dev/null \
    && pass "mem_sleep default is deep (S3)" \
    || fail "mem_sleep default is not deep: $(cat /sys/power/mem_sleep 2>/dev/null)"

if grep -Eq '(^| )pcie_aspm(=|\.policy=)' /proc/cmdline; then
    warn "kernel cmdline forces ASPM ($(grep -Eo 'pcie_aspm[^ ]*' /proc/cmdline | tr '\n' ' ')); all T2 stateful-suspend rejections happened with it"
else
    pass "kernel cmdline does not force ASPM"
fi

t2bce_ver="$(cat /sys/module/t2bce_core/version 2>/dev/null || true)"
if [[ "$t2bce_ver" == *nostatefix* ]]; then
    pass "patched t2bce loaded: t2bce_core $t2bce_ver"
else
    warn "t2bce_core '${t2bce_ver:-not loaded}' is not the patched build; run ws-suspend t2bce-build && ws-suspend t2bce-install (docs/suspend.md)"
fi

t2bce_param="$(cat /sys/module/t2bce_core/parameters/stateful_sleep 2>/dev/null || true)"
[[ -z "$t2bce_param" || "$t2bce_param" == "Y" ]] \
    && pass "t2bce stateful sleep enabled" \
    || fail "t2bce_core.stateful_sleep=$t2bce_param (forced no-state test mode left on)"

if apt-mark showhold 2>/dev/null | grep -qx 'linux-t2'; then
    pass "linux-t2 held (patched t2bce modules exist only for $(uname -r))"
else
    warn "linux-t2 is not held: a kernel update would boot the in-tree t2bce (docs/suspend.md)"
fi

t2bce_sources="$HOME/.local/share/workstation/t2bce/sources"
if awk -v k="$(uname -r)" '!/^#/ && $1 == k { found = 1 } END { exit !found }' "$t2bce_sources" 2>/dev/null; then
    pass "system/kernel/t2bce/t2bce.nix pins sources for $(uname -r)"
else
    warn "system/kernel/t2bce/t2bce.nix has no entry for $(uname -r)"
fi

if [[ -e /etc/systemd/system/tiny-dfr-sleep.service ]]; then
    warn "obsolete /etc/systemd/system/tiny-dfr-sleep.service still exists"
fi

section "14.2 Boot / recovery"

# The files and units themselves: ws system check. GRUB, rEFInd and the
# "Ubuntu (AMD)" entry get their kernel parameters from facts.nix.

# /etc/default/grub belongs to the grub package (ucf); workstation settings
# live only in grub.d drop-ins.
compare_file /usr/share/grub/default/grub /etc/default/grub \
    "/etc/default/grub is the package template"

# Recovery must not stop in emergency mode when a non-system disk is absent.
non_system_mounts="$(awk '$0 !~ /^[[:space:]]*#/ && NF >= 4 && $2 ~ /^\/mnt\// && $4 !~ /(^|,)nofail(,|$)/ { print $2 }' /etc/fstab 2>/dev/null)"
if [[ -z "$non_system_mounts" ]]; then
    pass "fstab: /mnt/* mounts are nofail"
else
    warn "fstab: /mnt/* without nofail ($(echo $non_system_mounts)); boot/recovery would stop in emergency mode without it"
fi

if [[ -e /etc/default/grub.d/90-pcie-aspm.cfg ]]; then
    warn "/etc/default/grub.d/90-pcie-aspm.cfg forces ASPM on GRUB/recovery kernels (docs/suspend.md)"
else
    pass "no forced ASPM in GRUB drop-ins"
fi

section "14.3 Default terminal (xdg-terminal-exec)"

# The lists and the .desktop are home-manager links (section 4).
for name in xdg-terminals.list ubuntu-xdg-terminals.list; do
    if grep -Fxq 'ghostty-open-here.desktop' "$HOME/.config/$name" 2>/dev/null; then
        pass "$name selects ghostty-open-here.desktop"
    else
        fail "$name does not select ghostty-open-here.desktop"
    fi
done
section "14.4 Nix layer (docs/plans/nix-migration.md)"

if compgen -G "$repo/flatpak/overrides/*.conf" >/dev/null; then
    fail "flatpak/overrides/*.conf is ignored; declare overrides in flatpak/flatpak.nix"
fi

if [[ -d /nix/var/nix ]]; then
    nix_source="$(findmnt -rno SOURCE /nix 2>/dev/null || true)"
    [[ "$nix_source" == *"[/@nix]" ]] \
        && pass "/nix is mounted from subvolume @nix" \
        || fail "/nix is not a separate @nix mount (${nix_source:-not mounted}); @ rollback would lose it"
    grep -Eq '^[^#]*[[:space:]]/nix[[:space:]].*subvol=@nix' /etc/fstab \
        && pass "fstab mounts @nix at /nix" \
        || fail "fstab has no @nix entry for /nix"

    for pkg in nix-bin nix-setup-systemd; do
        dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' \
            && pass "apt package installed: $pkg" \
            || fail "apt package missing: $pkg"
    done
    id -nG | tr ' ' '\n' | grep -Fxq nix-users \
        && pass "user session is in group nix-users" \
        || fail "user session not in group nix-users (usermod -aG nix-users, then log in again)"
    systemctl is-enabled --quiet nix-daemon.socket 2>/dev/null \
        && pass "nix-daemon.socket enabled" \
        || fail "nix-daemon.socket not enabled"
    systemctl is-active --quiet nix-daemon.socket 2>/dev/null \
        && pass "nix-daemon.socket active" \
        || fail "nix-daemon.socket not active"

    if have nix; then
        pass "nix in PATH: $(nix --version 2>/dev/null)"
        nix config show experimental-features 2>/dev/null | grep -qw flakes \
            && pass "nix: flakes enabled" \
            || fail "nix: experimental-features lack flakes"
    else
        fail "nix-bin installed but nix not in PATH"
    fi

    # Commands of the Nix profile (home.packages): each resolves to the
    # profile; a copy in /usr/bin (apt) would shadow it for sudo and
    # non-fish shells.
    for tool_path in "$hm_gen"/home-path/bin/*; do
        [[ -x "$tool_path" ]] || continue
        tool="${tool_path##*/}"
        [[ "$(command -v "$tool" 2>/dev/null)" == "$HOME/.nix-profile/bin/$tool" ]] \
            && pass "$tool from Nix profile" \
            || warn "$tool does not resolve to ~/.nix-profile/bin ($(command -v "$tool" 2>/dev/null || echo missing))"
        [[ -e "/usr/bin/$tool" ]] \
            && warn "/usr/bin/$tool exists too; Nix provides $tool (sudo apt remove the package)"
    done
    [[ -r "$repo/bootstrap.sh" && -x "$repo/bootstrap.sh" ]] \
        && pass "bootstrap.sh present and executable" \
        || fail "bootstrap.sh missing or not executable"
else
    warn "Nix not installed yet (phase 0 of docs/plans/nix-migration.md)"
fi

section "14.5 dGPU power / rEFInd Ubuntu (AMD)"

# rEFInd "Ubuntu" boots with ws.dgpu=off: ws-dgpu-off.service powers the AMD
# dGPU off and removes it from the PCI bus. "Ubuntu (AMD)" boots /boot/ws
# without it (docs/workstation.md, docs/suspend.md).
if grep -Eq '(^| )ws\.dgpu=off( |$)' /proc/cmdline; then
    systemctl is-active --quiet ws-dgpu-off.service 2>/dev/null \
        && pass "booted with ws.dgpu=off: ws-dgpu-off.service succeeded" \
        || fail "booted with ws.dgpu=off but ws-dgpu-off.service is not active (journalctl -b -u ws-dgpu-off)"
    # ws-dgpu-off removes the card only after its config space reads ffff
    # (power cut), so a bus without AMD devices means the card is off.
    amd_devices=""
    for dev in /sys/bus/pci/devices/*; do
        [[ "$(cat "$dev/vendor" 2>/dev/null)" == 0x1002 ]] && amd_devices+=" ${dev##*/}"
    done
    [[ -z "$amd_devices" ]] \
        && pass "AMD dGPU powered off and removed from PCI" \
        || fail "AMD devices still on the PCI bus:$amd_devices (journalctl -b -u ws-dgpu-off)"
else
    dgpu_state="$(cat /sys/bus/pci/devices/0000:03:00.0/power_state 2>/dev/null || echo absent)"
    pass "booted with the AMD dGPU on (rEFInd Ubuntu (AMD) or GRUB): $dgpu_state"
fi

newest_kernel="$(ls /boot/vmlinuz-* 2>/dev/null | sort -V | tail -n1)"
newest_version="${newest_kernel#/boot/vmlinuz-}"
if [[ -z "$newest_kernel" ]]; then
    fail "no /boot/vmlinuz-* found"
elif [[ /boot/ws/vmlinuz -ef "$newest_kernel" && /boot/ws/initrd.img -ef "/boot/initrd.img-$newest_version" ]]; then
    pass "/boot/ws links the newest kernel and initrd: $newest_version"
else
    fail "/boot/ws does not link $newest_version (kernel and initrd); run sudo /usr/local/sbin/ws-boot-links"
fi
[[ "$newest_version" == *-t2-* ]] \
    || warn "newest kernel $newest_version is not a T2 kernel; rEFInd boots it by default"

section "15. Extension schema source / generated files"

for uuid in $(ext_list local); do
    schema_dir="$repo/gnome/extensions/$uuid/schemas"
    if [[ -d "$schema_dir" ]]; then
        xml_count="$(find "$schema_dir" -maxdepth 1 -type f -name '*.gschema.xml' | wc -l)"
        if (( xml_count > 0 )); then
            pass "$uuid has GSettings schema source"
        else
            fail "$uuid has no *.gschema.xml source"
        fi

        if is_tracked "gnome/extensions/$uuid/schemas/gschemas.compiled"; then
            fail "$uuid generated gschemas.compiled is tracked"
        elif git -C "$repo" check-ignore -q -- "gnome/extensions/$uuid/schemas/gschemas.compiled"; then
            pass "$uuid generated gschemas.compiled is ignored"
        else
            warn "$uuid generated gschemas.compiled is not ignored"
        fi

        if have glib-compile-schemas; then
            schema_tmp="$(mktemp -d)"
            cp -a "$schema_dir/." "$schema_tmp/"
            rm -f "$schema_tmp/gschemas.compiled"
            if glib-compile-schemas "$schema_tmp" >/dev/null 2>&1; then
                pass "$uuid schema compiles"
            else
                fail "$uuid schema compilation failed"
            fi
            rm -rf -- "$schema_tmp"
        fi
    else
        pass "$uuid has no GSettings schemas"
    fi
done

section "16. Documentation consistency"

kdoc="$repo/docs/keyboard.md"
tdoc="$repo/docs/touchbar.md"

missing=()
for concept in "Always on Top" "Smart Popup" "CapsLock" "Tile Editing Mode" "ws-touchbar-fn" "unlock-dialog" "GDM/login" "EN -> RU -> UA -> EN"; do
    grep -Fqi -- "$concept" "$kdoc" 2>/dev/null || missing+=("$concept")
done
if ((${#missing[@]} == 0)); then
    pass "docs/keyboard.md includes final keyboard concepts"
else
    warn "docs/keyboard.md missing concepts: ${missing[*]}"
fi

if [[ -r "$tdoc" ]]; then
    if grep -Fqi 'Текущий режим Touch Bar — **родной**' "$tdoc" \
       && grep -Fqi '90-touchbar-native.rules' "$tdoc" \
       && grep -Fqi 'ws-touchbar-fn' "$tdoc"; then
        pass "docs/touchbar.md reflects native Touch Bar baseline"
    else
        fail "docs/touchbar.md does not describe the current native Touch Bar baseline"
    fi
else
    fail "docs/touchbar.md missing"
fi

for doc in docs/keyboard.md docs/workstation.md docs/rebuild.md docs/roadmap.md; do
    if [[ -r "$repo/$doc" ]]; then
        if grep -Eqi 'Текущ(ий|ее).*(renderer|baseline).*tiny-dfr|Touch Bar через `tiny-dfr`|sudo apt install tiny-dfr|config/tiny-dfr' "$repo/$doc"; then
            fail "$doc still describes tiny-dfr as the current Touch Bar baseline"
        else
            pass "$doc has no obsolete tiny-dfr baseline claim"
        fi
    else
        fail "$doc missing"
    fi
done

for uuid in $(ext_list local); do
    grep -Fqi "$uuid" "$repo/docs/workstation.md" \
        && pass "docs/workstation.md documents local extension $uuid" \
        || fail "docs/workstation.md misses local extension $uuid"
done

if [[ -r "$repo/docs/plans/gnome.md" ]]; then
    grep -Fqi 'Keyboard layer **завершён и является частью baseline**' "$repo/docs/plans/gnome.md" \
        && pass "docs/plans/gnome.md marks keyboard layer as completed baseline" \
        || fail "docs/plans/gnome.md still treats keyboard shortcuts as unfinished"
else
    fail "docs/plans/gnome.md missing"
fi


if [[ -r "$repo/docs/gnome.md" ]]; then
    grep -Fqi 'gnome/gnome.nix' "$repo/docs/gnome.md" \
        && grep -Fqi 'ws-gnome check' "$repo/docs/gnome.md" \
        && pass "docs/gnome.md documents the managed GNOME profile" \
        || fail "docs/gnome.md does not document the current managed GNOME profile"
else
    fail "docs/gnome.md missing"
fi

grep -Fqi 'Wine на host не устанавливается' "$repo/docs/gnome.md" 2>/dev/null \
    && pass "docs/gnome.md preserves host-without-Wine architecture" \
    || warn "docs/gnome.md does not explicitly preserve host-without-Wine architecture"

# Man pages are built by Nix from docs/ (nix/pkgs/man.nix) and linked by
# home-manager into ~/.local/share/man/man1; man/ is not kept in git.
if [[ -n "$(git -C "$repo" ls-files -- man)" ]]; then
    fail "man/ is tracked in git; pages are built by Nix (nix/pkgs/man.nix)"
else
    pass "man/ not tracked (pages built by Nix)"
fi
if have nix; then
    man_built="$(nix eval --raw "$repo#packages.$(uname -m)-linux.man.outPath" 2>/dev/null || true)"
    man_missing=false
    man_stale=false
    for doc in "$repo"/docs/*.md "$repo"/docs/plans/*.md; do
        page="$(sed -n 's/^title:[[:space:]]*//p' "$doc" | head -n 1)"
        [[ -n "$page" ]] || continue
        link="$HOME/.local/share/man/man1/$page.1"
        if [[ ! -e "$link" ]]; then
            man_missing=true
            warn "man page missing: $page (ws switch)"
        elif [[ -n "$man_built" && "$(readlink -f "$link")" != "$man_built/"* ]]; then
            man_stale=true
        fi
    done
    [[ "$man_missing" == false ]] && pass "man pages installed for every docs title"
    if [[ -z "$man_built" ]]; then
        warn "cannot evaluate the man package of the flake"
    elif [[ "$man_stale" == true ]]; then
        warn "man pages are older than docs/ (ws switch)"
    else
        pass "man pages match docs/ (${man_built#/nix/store/})"
    fi
fi

section "17. Legacy artifacts that should be gone"

# Generated files live in ~/.local/share/workstation (before 2026-09-27:
# ~/.config/workstation and ~/.cache/ws-suspend).
for old in "$HOME/.config/workstation" "$HOME/.cache/ws-suspend" \
    "$HOME/.local/share/distrobox-homes"; do
    if [[ -e "$old" || -L "$old" ]]; then
        cleanup "obsolete directory: $(q "$old") (docs/workstation.md: ~/.local/share/workstation, ~/distrobox)"
    else
        pass "obsolete directory absent: $old"
    fi
done

# Machine-local state lives in ~/.local/state/workstation, not in the checkout.
if [[ -e "$repo/state" ]]; then
    fail "state/ in the checkout is obsolete: move keyboard/gsettings-backup.tsv to ~/.local/state/workstation/keyboard/"
else
    pass "no state/ in the checkout"
fi

legacy_repo_paths=(
    bin/ws-nautilus-go
    bin/ws-gnome-apply
    systemd
    # Layout before ~/wsconfig (2026-09-27): config/, modules/, kernel/,
    # hosts/, pkgs/ and the system tree directly under system/.
    config
    modules
    kernel
    hosts
    pkgs
    system/udev
    system/modprobe
    system/systemd
    system/usr
    system/boot/refind_linux.conf
    system/default
    system/esp
    system/NetworkManager
    system/sleep.conf.d
    system/modules-load.d
    system/files/udev/70-workstation-uinput.rules
    system/kernel/t2bce/sources.conf
    # micro writes its buffers into ~/.local/share/workstation/micro-help.
    terminal/micro-help/buffers
)
for path in "${legacy_repo_paths[@]}"; do
    if is_tracked "$path"; then
        cleanup "obsolete tracked artifact: $(q "$path")"
        git_remove_candidates+=("$path")
    elif [[ -e "$repo/$path" || -L "$repo/$path" ]]; then
        cleanup "obsolete untracked artifact in repo: $(q "$path")"
    else
        pass "legacy artifact absent: $path"
    fi
done

if systemctl list-unit-files tiny-dfr-sleep.service 2>/dev/null | grep -q '^tiny-dfr-sleep\.service'; then
    warn "obsolete tiny-dfr-sleep.service still installed"
else
    pass "obsolete tiny-dfr-sleep.service not installed"
fi

section "18. Untracked files / cleanup candidates"

untracked_any=false
while IFS= read -r -d '' path; do
    untracked_any=true
    base="${path##*/}"
    case "$base" in
        *~|*.bak|*.backup|*.orig|*.rej|*.swp|*.swo|*.tmp|*.temp|.DS_Store|Thumbs.db|*.pyc)
            cleanup "untracked backup/editor/temp candidate: $(q "$path")"
            ;;
        *)
            case "$path" in
                runtime/*|*/schemas/gschemas.compiled)
                    info "ignored/generated untracked file: $(q "$path")"
                    ;;
                fix-keyboard-layer-v*.sh|*/fix-keyboard-layer-v*.sh|rollback-keyboard-layer-v*.sh|*/rollback-keyboard-layer-v*.sh)
                    cleanup "untracked one-shot migration/fix script candidate: $(q "$path")"
                    ;;
                *)
                    info "untracked: $(q "$path")"
                    ;;
            esac
            ;;
    esac
done < <(git -C "$repo" ls-files --others --exclude-standard -z)
[[ "$untracked_any" == false ]] && pass "no non-ignored untracked files"

# Detect tracked files deleted locally: those need git rm / git add -u, not git add .
while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    xy="${line:0:2}"
    path="${line:3}"
    if [[ "$xy" == *D* ]]; then
        git_remove_candidates+=("$path")
    fi
done <<<"$status_porcelain"

section "19. Safe Git plan (NO commands executed)"

if ((${#git_remove_candidates[@]})); then
    mapfile -t git_remove_candidates < <(printf '%s\n' "${git_remove_candidates[@]}" | awk '!seen[$0]++')
    echo
    echo "  Paths that look like tracked junk/deletions (REVIEW before removal):"
    for p in "${git_remove_candidates[@]}"; do printf '        %q\n' "$p"; done
    echo
    echo "  After manual review, remove a confirmed tracked junk file with:"
    echo "        git -C $(q "$repo") rm -- <exact-path>"
fi

cat <<EOF2

  Final review commands (safe/read-only):
        git -C $(q "$repo") status --short
        git -C $(q "$repo") diff --check
        git -C $(q "$repo") diff
        git -C $(q "$repo") diff --cached
        git -C $(q "$repo") ls-files -s

  Do NOT use 'git add .' for this cleanup. Add only reviewed source files explicitly.
EOF2

section "20. Final summary"

printf '  PASS:    %d\n' "$pass_n"
printf '  WARN:    %d\n' "$warn_n"
printf '  FAIL:    %d\n' "$fail_n"
printf '  INFO:    %d\n' "$info_n"
printf '  CLEANUP: %d candidate(s)\n' "$cleanup_n"

echo
if ((${#cleanup_items[@]})); then
    echo "Cleanup candidates detected (nothing was removed):"
    for item in "${cleanup_items[@]}"; do
        printf '  - %s\n' "$item"
    done
    echo
fi

if ((fail_n > 0)); then
    echo "RESULT: FAILED"
    exit 1
elif [[ "$strict" == true && $warn_n -gt 0 ]]; then
    echo "RESULT: WARNINGS (--strict)"
    exit 2
elif ((warn_n > 0)); then
    echo "RESULT: PASSED WITH WARNINGS"
    exit 0
else
    echo "RESULT: PASSED"
    exit 0
fi
