section "9. GNOME core bindings"

# The profile of keyboard/keyboard.nix, set by ws-keyboard-apply.
kb_dir="$HOME/.local/share/workstation/keyboard"

if have gsettings && [[ -r "$kb_dir/gnome-shortcuts.tsv" ]]; then
    kb_total=0
    kb_bad=0
    while IFS=$'\t' read -r schema key value kind; do
        [[ -z "$schema" || "$schema" == \#* ]] && continue
        if [[ "$kind" == optional ]] && ! gsettings range "$schema" "$key" >/dev/null 2>&1; then
            continue
        fi
        ((kb_total += 1))
        actual="$(gget "$schema" "$key")"
        # A string-typed key holds the first element of the declared array.
        if [[ "$actual" != "$value" && "$actual" == \'* && "$value" == \[* ]]; then
            value="$(sed -E "s/^\[('([^'\\\\]|\\\\.)*')?.*$/\1/" <<<"$value")"
        fi
        if [[ "$actual" != "$value" ]]; then
            ((kb_bad += 1))
            fail "GNOME shortcut $schema $key = ${actual:-MISSING}, profile: $value (ws apply keyboard)"
        fi
    done < "$kb_dir/gnome-shortcuts.tsv"
    ((kb_bad == 0)) && pass "GNOME shortcuts match keyboard/keyboard.nix ($kb_total keys)"
else
    fail "gsettings or keyboard shortcut data missing"
fi

