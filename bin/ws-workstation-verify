for uuid in $(ext_list ego) $(ext_list local); do
    extension_active "$uuid" "GNOME extension active"
done

if have gnome-extensions && gnome-extensions info tiling-assistant@ubuntu.com 2>/dev/null | grep -Eq 'State:[[:space:]]+ACTIVE|Enabled:[[:space:]]+Yes'; then
    pass "Tiling Assistant active: tiling-assistant@ubuntu.com"
elif have gnome-extensions && gnome-extensions info tiling-assistant@leleat-on-github 2>/dev/null | grep -Eq 'State:[[:space:]]+ACTIVE|Enabled:[[:space:]]+Yes'; then
    pass "Tiling Assistant active: tiling-assistant@leleat-on-github"
else
    fail "Tiling Assistant not active"
fi

if have gdbus && gdbus call --session \
    --dest org.gnome.Shell \
    --object-path /org/gnome/Shell/Extensions/WorkstationInputSource \
    --method org.gnome.Shell.Extensions.WorkstationInputSource.GetState \
    >/dev/null 2>&1; then
    pass "Input Source D-Bus API responds"
else
    fail "Input Source D-Bus API unavailable"
fi

for uuid in $(ext_list local); do
    for file in metadata.json extension.js; do
        src="$repo/gnome/extensions/$uuid/$file"
        dst="$HOME/.local/share/gnome-shell/extensions/$uuid/$file"
