section "9. GNOME core bindings"

if have gsettings; then
    gcontains org.gnome.desktop.wm.keybindings switch-applications '<Super>Tab' "Cmd/Win+Tab app switch"
    same_app="$(gget org.gnome.desktop.wm.keybindings switch-group)"
    if [[ "$same_app" == *"<Super>Above_Tab"* && "$same_app" == *"<Control>Down"* ]]; then
        pass "same-app window switch (<Super>Above_Tab + <Control>Down)"
    else
        fail "same-app window switch — got: ${same_app:-MISSING}"
    fi
    gcontains org.gnome.desktop.wm.keybindings minimize '<Super>m' "Cmd/Win+M minimize"
    gcontains org.gnome.desktop.wm.keybindings toggle-fullscreen '<Control><Super>f' "Ctrl+Cmd/Win+F fullscreen"
    gcontains org.gnome.desktop.wm.keybindings show-desktop 'F11' "F11 show desktop"
    gcontains org.gnome.shell.keybindings toggle-overview '<Super>space' "Cmd/Win+Space overview"
    gcontains org.gnome.settings-daemon.plugins.media-keys screensaver '<Control><Super>q' "Ctrl+Cmd/Win+Q lock"

    overlay="$(gget org.gnome.mutter overlay-key)"
    [[ "$overlay" == "''" ]] \
        && pass "single Super/Command disabled" \
        || fail "single Super/Command not disabled: $overlay"

    numeric_ok=true
    for n in $(seq 1 9); do
        v="$(gget org.gnome.shell.keybindings "switch-to-application-$n")"
        [[ "$v" == "@as []" || "$v" == "[]" ]] || numeric_ok=false
    done
    [[ "$numeric_ok" == true ]] \
        && pass "GNOME Super+1..9 launcher bindings disabled" \
        || fail "one or more GNOME Super+1..9 bindings are enabled"

    if gsettings range org.gnome.shell.extensions.dash-to-dock hot-keys >/dev/null 2>&1; then
        dock="$(gget org.gnome.shell.extensions.dash-to-dock hot-keys)"
        [[ "$dock" == "false" ]] \
            && pass "Ubuntu Dock numeric hotkeys disabled" \
            || fail "Ubuntu Dock numeric hotkeys enabled"
    fi
else
    fail "gsettings binary missing"
fi

