section "15. Extension schema source / generated files"

for uuid in workstation-smart-popup@local workstation-input-source@local; do
    schema_dir="$repo/gnome/extensions/$uuid/schemas"
    if [[ -d "$schema_dir" ]]; then
        xml_count="$(find "$schema_dir" -maxdepth 1 -type f -name '*.gschema.xml' | wc -l)"
        if (( xml_count > 0 )); then
            pass "$uuid has GSettings schema source"
        else
            fail "$uuid has no *.gschema.xml source"
        fi

        if is_tracked "gnome/extensions/$uuid/schemas/gschemas.compiled"; then
            fail "$uuid generated gschemas.compiled is tracked"
        elif git -C "$repo" check-ignore -q -- "gnome/extensions/$uuid/schemas/gschemas.compiled"; then
            pass "$uuid generated gschemas.compiled is ignored"
        else
            warn "$uuid generated gschemas.compiled is not ignored"
        fi

        if have glib-compile-schemas; then
            schema_tmp="$(mktemp -d)"
            cp -a "$schema_dir/." "$schema_tmp/"
            rm -f "$schema_tmp/gschemas.compiled"
            if glib-compile-schemas "$schema_tmp" >/dev/null 2>&1; then
                pass "$uuid schema compiles"
            else
                fail "$uuid schema compilation failed"
            fi
            rm -rf -- "$schema_tmp"
        fi
    else
        fail "$uuid schemas directory missing"
    fi
done

section "16. Documentation consistency"

kdoc="$repo/docs/keyboard.md"
tdoc="$repo/docs/touchbar.md"

missing=()
for concept in "Always on Top" "Smart Popup" "CapsLock" "Tile Editing Mode" "tiny-dfr" "unlock-dialog" "GDM/login" "EN -> RU -> UA -> EN"; do
    grep -Fqi -- "$concept" "$kdoc" 2>/dev/null || missing+=("$concept")
done
if ((${#missing[@]} == 0)); then
    pass "docs/keyboard.md includes final keyboard concepts"
else
    warn "docs/keyboard.md missing concepts: ${missing[*]}"
fi

if [[ -r "$tdoc" ]]; then
    if grep -Fqi 'Текущий Touch Bar renderer — **tiny-dfr**' "$tdoc" \
       && grep -Fqi 'DoublePressSwitchLayers = 0' "$tdoc"; then
        pass "docs/touchbar.md reflects tiny-dfr baseline"
    else
        fail "docs/touchbar.md does not describe the current tiny-dfr baseline"
    fi
else
    fail "docs/touchbar.md missing"
fi

for doc in docs/workstation.md docs/rebuild.md docs/roadmap.md; do
    if [[ -r "$repo/$doc" ]]; then
        if grep -Eqi 'Не (используются|устанавливать).*tiny-dfr|штатн(ый|ого).*Touch Bar.*hid[_-]?appletb' "$repo/$doc"; then
            fail "$doc still contains obsolete current-baseline claims about tiny-dfr/hid_appletb"
        else
            pass "$doc has no obsolete tiny-dfr/hid_appletb baseline claim"
        fi
    else
        fail "$doc missing"
    fi
done

grep -Fqi 'workstation-input-source@local' "$repo/docs/workstation.md" \
    && pass "docs/workstation.md includes final input-source extension" \
    || fail "docs/workstation.md misses final input-source extension"

grep -Fqi 'workstation-smart-popup@local' "$repo/docs/workstation.md" \
    && pass "docs/workstation.md includes Smart Popup extension" \
    || fail "docs/workstation.md misses Smart Popup extension"

if [[ -r "$repo/docs/plans/gnome.md" ]]; then
    grep -Fqi 'Keyboard layer **завершён и является частью baseline**' "$repo/docs/plans/gnome.md" \
        && pass "docs/plans/gnome.md marks keyboard layer as completed baseline" \
        || fail "docs/plans/gnome.md still treats keyboard shortcuts as unfinished"

    grep -Fqi 'workstation-input-source@local' "$repo/docs/plans/gnome.md" \
        && grep -Fqi 'workstation-smart-popup@local' "$repo/docs/plans/gnome.md" \
        && pass "docs/plans/gnome.md lists current local extensions" \
        || fail "docs/plans/gnome.md does not list current local extensions"
else
    fail "docs/plans/gnome.md missing"
fi

if [[ -x "$repo/bin/ws-doc-build" ]] && have lowdown; then
    doc_tmp="$(mktemp -d)"
    mkdir -p "$doc_tmp/docs" "$doc_tmp/bin" "$doc_tmp/man/man1"
    cp -a "$repo/docs/." "$doc_tmp/docs/"
    cp -a "$repo/bin/ws-doc-build" "$doc_tmp/bin/ws-doc-build"

    if WORKSTATION_CONFIG="$doc_tmp" "$doc_tmp/bin/ws-doc-build" >"$doc_tmp/build.log" 2>&1; then
        doc_diff=false
        shopt -s nullglob
        for generated in "$doc_tmp"/man/man1/*.1; do
            name="${generated##*/}"
            if [[ ! -f "$repo/man/man1/$name" ]]; then
                doc_diff=true
                warn "generated man page missing from repo: man/man1/$name"
            elif ! cmp -s "$generated" "$repo/man/man1/$name"; then
                doc_diff=true
                warn "generated man page differs from repo: man/man1/$name"
            fi
        done
        shopt -u nullglob
        [[ "$doc_diff" == false ]] && pass "documentation/man generation reproducible in temporary copy"
    else
        warn "ws-doc-build failed in temporary copy:"
        sed 's/^/        /' "$doc_tmp/build.log"
    fi
    rm -rf -- "$doc_tmp"
elif [[ ! -x "$repo/bin/ws-doc-build" ]]; then
    info "ws-doc-build unavailable; doc-generation check skipped"
else
    info "lowdown unavailable; doc-generation check skipped"
fi

section "17. Legacy artifacts that should be gone"

legacy_repo_paths=(
    bin/ws-nautilus-go
    systemd/user/ws-touchbar-fn.service
    system/udev/70-workstation-uinput.rules
)
for path in "${legacy_repo_paths[@]}"; do
    if is_tracked "$path"; then
        cleanup "obsolete tracked artifact: $(q "$path")"
        git_remove_candidates+=("$path")
    elif [[ -e "$repo/$path" || -L "$repo/$path" ]]; then
        cleanup "obsolete untracked artifact in repo: $(q "$path")"
    else
        pass "legacy artifact absent: $path"
    fi
done

if [[ -e /usr/local/libexec/ws-touchbar-fn || -L /usr/local/libexec/ws-touchbar-fn ]]; then
    warn "obsolete runtime helper still exists: /usr/local/libexec/ws-touchbar-fn"
else
    pass "obsolete /usr/local/libexec/ws-touchbar-fn absent"
fi

if systemctl list-unit-files ws-touchbar-fn.service >/dev/null 2>&1 \
   && systemctl list-unit-files ws-touchbar-fn.service 2>/dev/null | grep -q '^ws-touchbar-fn\.service'; then
    warn "obsolete ws-touchbar-fn.service still installed"
else
    pass "obsolete ws-touchbar-fn.service not installed"
fi

section "18. Untracked files / cleanup candidates"

untracked_any=false
while IFS= read -r -d '' path; do
    untracked_any=true
    base="${path##*/}"
    case "$base" in
        *~|*.bak|*.backup|*.orig|*.rej|*.swp|*.swo|*.tmp|*.temp|.DS_Store|Thumbs.db|*.pyc)
            cleanup "untracked backup/editor/temp candidate: $(q "$path")"
            ;;
        *)
            case "$path" in
                state/*|runtime/*|config/micro-help/buffers/*|*/schemas/gschemas.compiled)
                    info "ignored/generated untracked file: $(q "$path")"
                    ;;
                fix-keyboard-layer-v*.sh|*/fix-keyboard-layer-v*.sh|rollback-keyboard-layer-v*.sh|*/rollback-keyboard-layer-v*.sh)
                    cleanup "untracked one-shot migration/fix script candidate: $(q "$path")"
                    ;;
                *)
                    info "untracked: $(q "$path")"
                    ;;
            esac
            ;;
    esac
done < <(git -C "$repo" ls-files --others --exclude-standard -z)
[[ "$untracked_any" == false ]] && pass "no non-ignored untracked files"

# Detect tracked files deleted locally: those need git rm / git add -u, not git add .
while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    xy="${line:0:2}"
    path="${line:3}"
    if [[ "$xy" == *D* ]]; then
        git_remove_candidates+=("$path")
    fi
done <<<"$status_porcelain"

section "19. Safe Git plan (NO commands executed)"

if ((${#git_add_candidates[@]})); then
    # Deduplicate while preserving user-readable order.
    mapfile -t git_add_candidates < <(printf '%s\n' "${git_add_candidates[@]}" | awk '!seen[$0]++')
    echo "  Files that exist locally but are missing from Git and belong to the source-of-truth:"
    for p in "${git_add_candidates[@]}"; do printf '        %q\n' "$p"; done
    echo
    print_cmd_array "git -C $(q "$repo") add --" "${git_add_candidates[@]}"
else
    pass "no required source files are waiting to be added"
fi

if ((${#git_remove_candidates[@]})); then
    mapfile -t git_remove_candidates < <(printf '%s\n' "${git_remove_candidates[@]}" | awk '!seen[$0]++')
    echo
    echo "  Paths that look like tracked junk/deletions (REVIEW before removal):"
    for p in "${git_remove_candidates[@]}"; do printf '        %q\n' "$p"; done
    echo
    echo "  After manual review, remove a confirmed tracked junk file with:"
    echo "        git -C $(q "$repo") rm -- <exact-path>"
fi

cat <<EOF2

  Final review commands (safe/read-only):
        git -C $(q "$repo") status --short
        git -C $(q "$repo") diff --check
        git -C $(q "$repo") diff
        git -C $(q "$repo") diff --cached
        git -C $(q "$repo") ls-files -s

  Do NOT use 'git add .' for this cleanup. Add only reviewed source files explicitly.
EOF2

section "20. Final summary"

printf '  PASS:    %d\n' "$pass_n"
printf '  WARN:    %d\n' "$warn_n"
printf '  FAIL:    %d\n' "$fail_n"
printf '  INFO:    %d\n' "$info_n"
printf '  CLEANUP: %d candidate(s)\n' "$cleanup_n"

echo
if ((${#cleanup_items[@]})); then
    echo "Cleanup candidates detected (nothing was removed):"
    for item in "${cleanup_items[@]}"; do
        printf '  - %s\n' "$item"
    done
    echo
fi

if ((fail_n > 0)); then
    echo "RESULT: FAILED"
    exit 1
elif [[ "$strict" == true && $warn_n -gt 0 ]]; then
    echo "RESULT: WARNINGS (--strict)"
    exit 2
elif ((warn_n > 0)); then
    echo "RESULT: PASSED WITH WARNINGS"
    exit 0
else
    echo "RESULT: PASSED"
    exit 0
fi
