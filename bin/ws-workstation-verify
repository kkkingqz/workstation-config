    contains "$smart" 'tiling-assistant@ubuntu\.com' "Smart Popup knows Ubuntu Tiling Assistant UUID"
    contains "$smart" 'tiling-assistant@leleat-on-github' "Smart Popup has upstream Tiling Assistant fallback"
