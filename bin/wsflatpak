#!/usr/bin/env python3
import argparse
import configparser
import os
from pathlib import Path
import shutil
import subprocess
import sys

SELF = Path(__file__).resolve()
REPO = Path(os.environ.get("WORKSTATION_CONFIG", SELF.parent.parent))
CFG = REPO / "config" / "flatpak"
APPS = CFG / "apps.conf"
REMOTES = CFG / "remotes.conf"
OVERRIDES = CFG / "overrides"


def run(args, check=True, capture=False):
    p = subprocess.run(args, text=True, capture_output=capture)
    if check and p.returncode:
        raise SystemExit(p.returncode)
    return p


def need_flatpak():
    if not shutil.which("flatpak"):
        raise SystemExit("wsflatpak: flatpak is not installed")


def ensure_cfg():
    OVERRIDES.mkdir(parents=True, exist_ok=True)
    APPS.touch(exist_ok=True)
    REMOTES.touch(exist_ok=True)


def managed_apps():
    ensure_cfg()
    out = []
    for raw in APPS.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if line and line not in out:
            out.append(line)
    return out


def resolve_user_app(query):
    """Resolve full App ID, display name, or final App-ID component."""
    need_flatpak()

    p = run(
        [
            "flatpak",
            "list",
            "--user",
            "--app",
            "--columns=application,name",
        ],
        check=False,
        capture=True,
    )

    q = query.casefold()
    matches = []

    for raw in p.stdout.splitlines():
        if not raw.strip():
            continue

        parts = raw.split("\t", 1)
        app_id = parts[0].strip()
        name = parts[1].strip() if len(parts) > 1 else ""

        aliases = {
            app_id.casefold(),
            app_id.rsplit(".", 1)[-1].casefold(),
        }

        if name:
            aliases.add(name.casefold())

        if q in aliases:
            matches.append(app_id)

    matches = list(dict.fromkeys(matches))

    if len(matches) == 1:
        return matches[0]

    if len(matches) > 1:
        raise SystemExit(
            "wsflatpak: ambiguous app name "
            + query
            + ": "
            + ", ".join(matches)
        )

    raise SystemExit(
        f"wsflatpak: {query} is not installed in user scope"
    )


def resolve_user_app(query):
    """Resolve full App ID, display name, or final App-ID component."""
    need_flatpak()

    p = run(
        [
            "flatpak",
            "list",
            "--user",
            "--app",
