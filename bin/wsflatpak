    """Resolve full App ID, display name, or final App-ID component."""
    need_flatpak()

    p = run(
        [
            "flatpak",
            "list",
            "--user",
            "--app",
            "--columns=application,name",
        ],
        check=False,
        capture=True,
    )

    q = query.casefold()
    matches = []

    for raw in p.stdout.splitlines():
        if not raw.strip():
            continue

