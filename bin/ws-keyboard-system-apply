#!/usr/bin/env bash
set -euo pipefail

# System keyboard/uinput/Touch Bar layer: 99-workstation-uinput.rules, GDM/login
# keyboard EN only, Touch Bar native mode (90-touchbar-native.rules, tb.conf,
# touchbar-native.conf, ws-touchbar-fn + unit).
#
# Since phase 4 of docs/plans/nix-migration.md one owner installs all system
# files: `ws system apply` (modules/system). The name stays: rebuild.md and
# verify refer to it.

repo="${WORKSTATION_CONFIG:-$HOME/.local/share/workstation-config}"
exec "$repo/bin/ws" system apply "$@"
