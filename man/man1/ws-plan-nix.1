.IP "\(bu" 3
\f(CR\(ti/.config/{ubuntu-,}xdg-terminals.list\fR и
\f(CR\(ti/.local/share/applications/ghostty-open-here.desktop\fR
(\f(CRconfig/xdg-terminals/\fR, захвачены в фазе −1);
